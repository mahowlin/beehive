#!/bin/bash
# beehive - Multi-agent orchestration for CLI-backed coding agents
#
# Usage:
#   beehive [path]           Run agents (auto-detects mode)
#   beehive --init [path]    Initialize repo/workspace structure
#   beehive --upgrade [path] Upgrade skills, commands, and template
#   beehive --status [path]  Show work items, agent states, and inbox
#   beehive --validate [path] Validate beads health and sessions metadata
#
# The tool auto-detects:
#   - Workspace mode: if path contains multiple git repos
#   - Single repo mode: if path is a single repository
#
# This uses an interactive model where the user directs agents and copies
# messages between them (not autonomous).

set -e

VERSION="0.5.2"

# Resolve symlinks to find actual script location (portable for Linux/macOS)
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
    SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
    SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
    [[ "$SCRIPT_SOURCE" != /* ]] && SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# DEFAULT_SESSION is set dynamically from folder name
CONFIG_FILE=".beehive.conf"

#######################################
# Helpers
#######################################
die() { echo -e "${RED}ERROR: $1${NC}" >&2; exit 1; }
warn() { echo -e "${YELLOW}WARNING: $1${NC}" >&2; }
info() { echo -e "${CYAN}$1${NC}"; }
success() { echo -e "${GREEN}$1${NC}"; }
require_jq() { command -v jq &>/dev/null || die "jq required. Install: brew install jq / apt install jq"; }
require_bd() {
    command -v bd &>/dev/null || die "bd (beads) required. Install: brew install steveyegge/tap/beads"
    local bd_ver
    bd_ver=$(bd version 2>/dev/null | awk '{print $3}')
    if [[ -z "$bd_ver" ]]; then
        die "Could not determine bd version. Run: bd version"
    fi
    # Compare version: require >= 0.61.0
    local IFS='.'
    local -a got=($bd_ver) want=(0 61 0)
    for i in 0 1 2; do
        local g="${got[$i]:-0}" w="${want[$i]:-0}"
        if (( g > w )); then return 0; fi
        if (( g < w )); then
            die "bd (beads) v0.61.0+ required (got v$bd_ver). Update: brew upgrade beads"
        fi
    done
}

#######################################
# Parse config file safely (no source)
#######################################
load_config() {
    local config_path="$1/$CONFIG_FILE"
    [[ ! -f "$config_path" ]] && return 1

    info "Loading config from $config_path"
    while IFS='=' read -r key value; do
        # Skip comments and empty lines
        [[ "$key" =~ ^[[:space:]]*# ]] && continue
        [[ -z "$key" ]] && continue

        # Remove leading/trailing whitespace and quotes
        key=$(echo "$key" | xargs)
        value=$(echo "$value" | xargs | sed 's/^["'"'"']//;s/["'"'"']$//')

        # Only allow known config keys (store as CONF_* to avoid clobbering CLI args)
        case "$key" in
            CONF_AWS_PROFILE)         CONF_AWS_PROFILE="$value" ;;
            CONF_AWS_REGION)          CONF_AWS_REGION="$value" ;;
            CONF_MODEL)               CONF_MODEL="$value" ;;
            CONF_MODEL_BEE)           CONF_MODEL_BEE="$value" ;;
            CONF_MODEL_QUEEN)         CONF_MODEL_QUEEN="$value" ;;
            CONF_SESSION)             CONF_SESSION="$value" ;;
            CONF_CLAUDE_CMD)          CONF_CLAUDE_CMD="$value" ;;
            CONF_CLI)                 CONF_CLI="$value" ;;
            CONF_CLI_CMD)             CONF_CLI_CMD="$value" ;;
            CONF_APPROVAL_MODE)       CONF_APPROVAL_MODE="$value" ;;
            CONF_ANTHROPIC_BASE_URL)  CONF_ANTHROPIC_BASE_URL="$value" ;;
            CONF_ANTHROPIC_API_KEY)   CONF_ANTHROPIC_API_KEY="$value" ;;
            CONF_BEES)                CONF_BEES="$value" ;;
            CONF_QUEEN)               CONF_QUEEN="$value" ;;
            CONF_AGENT_CMD)           CONF_CLI_CMD="$value" ;;
        esac
    done < "$config_path"
    return 0
}

#######################################
# Detect clipboard for current OS
#######################################
detect_clipboard() {
    if command -v pbcopy &> /dev/null; then
        echo "pbcopy"
    elif command -v xclip &> /dev/null; then
        echo "xclip -selection clipboard"
    elif command -v xsel &> /dev/null; then
        echo "xsel --clipboard --input"
    else
        echo "cat > /dev/null"
    fi
}

#######################################
# Resolve agent CLI command
#######################################
resolve_cli_command() {
    local cli_family="$1" explicit_cmd="$2"

    if [[ -n "$explicit_cmd" ]]; then
        command -v "$explicit_cmd" &> /dev/null && echo "$explicit_cmd" && return 0
        return 1
    fi

    case "$cli_family" in
        claude)
            [[ -n "${CONF_CLAUDE_CMD:-}" ]] && command -v "$CONF_CLAUDE_CMD" &> /dev/null && echo "$CONF_CLAUDE_CMD" && return 0
            for loc in claude /opt/homebrew/bin/claude /usr/local/bin/claude "$HOME/.local/bin/claude"; do
                command -v "$loc" &> /dev/null && echo "$loc" && return 0
            done
            ;;
        codex)
            command -v codex &> /dev/null && echo "codex" && return 0
            ;;
        cursor)
            command -v agent &> /dev/null && echo "agent" && return 0
            ;;
    esac
    return 1
}

#######################################
# Resolve setting with 4-tier precedence:
#   role CLI → global CLI → role config → global config
#######################################
resolve_setting() {
    local cli_value="$1" cli_fallback="$2" config_value="$3" config_fallback="$4"
    if [[ -n "$cli_value" ]]; then echo "$cli_value"
    elif [[ -n "$cli_fallback" ]]; then echo "$cli_fallback"
    elif [[ -n "$config_value" ]]; then echo "$config_value"
    elif [[ -n "$config_fallback" ]]; then echo "$config_fallback"
    fi
}

#######################################
# Resolve fixed, safe approval arguments for each CLI.
# Never accept arbitrary approval flags from configuration.
#######################################
resolve_approval_args() {
    local cli_family="$1" approval_mode="$2"

    [[ "$approval_mode" == "manual" ]] && return 0
    [[ "$approval_mode" == "auto" ]] || die "Approval mode must be auto or manual (got: $approval_mode)"

    case "$cli_family" in
        claude)
            printf '%q %q' "--permission-mode" "auto"
            ;;
        codex)
            printf '%q %q %q %q %q %q' \
                "--sandbox" "workspace-write" \
                "--ask-for-approval" "on-request" \
                "-c" "approvals_reviewer=auto_review"
            ;;
        cursor)
            # Cursor has no verified equivalent; preserve its native defaults.
            return 0
            ;;
        *)
            die "Unsupported CLI family for approval mode: $cli_family"
            ;;
    esac
}

#######################################
# Build per-pane shell command with env vars and model
# Uses inline env prefix (VAR=val cmd) so vars are scoped to the command
#######################################
build_pane_command() {
    local prompt="$1" model="$2" actor="${3:-}"
    local env_prefix="env -u CLAUDECODE COLORTERM=truecolor CLICOLOR=1 CLICOLOR_FORCE=1 FORCE_COLOR=1"
    [[ -n "$AWS_PROFILE" ]] && env_prefix+=" AWS_PROFILE=$(printf '%q' "$AWS_PROFILE")"
    [[ -n "$AWS_REGION" ]] && env_prefix+=" AWS_REGION=$(printf '%q' "$AWS_REGION")"
    [[ -n "$ANTHROPIC_BASE_URL" ]] && env_prefix+=" ANTHROPIC_BASE_URL=$(printf '%q' "$ANTHROPIC_BASE_URL")"
    [[ -n "$ANTHROPIC_API_KEY" ]] && env_prefix+=" ANTHROPIC_API_KEY=$(printf '%q' "$ANTHROPIC_API_KEY")"
    [[ -n "$model" ]] && env_prefix+=" ANTHROPIC_MODEL=$(printf '%q' "$model")"
    [[ -n "$actor" ]] && env_prefix+=" BD_ACTOR=$(printf '%q' "$actor")"
    local approval_args
    approval_args=$(resolve_approval_args "${CLI_FAMILY:-claude}" "${APPROVAL_MODE:-auto}")
    if [[ -n "$approval_args" ]]; then
        printf '%s %q %s %q' "$env_prefix" "$AGENT_CMD" "$approval_args" "$prompt"
    else
        printf '%s %q %q' "$env_prefix" "$AGENT_CMD" "$prompt"
    fi
}

#######################################
# Detect if path is workspace or repo
#######################################
detect_mode() {
    local path="$1"

    # Count git repos in directory
    local git_count=0
    for dir in "$path"/*/; do
        [[ -d "$dir/.git" ]] && git_count=$((git_count + 1))
    done

    # Multiple git repos = workspace, otherwise single repo
    [[ $git_count -gt 1 ]] && echo "workspace" || echo "repo"
}

#######################################
# Initialize structure
#######################################
do_init() {
    local path="$1"
    local mode
    mode=$(detect_mode "$path")

    echo ""
    if [[ "$mode" == "workspace" ]]; then
        info "Initializing workspace in: $path"
        init_workspace "$path"
    else
        info "Initializing repository in: $path"
        init_repo "$path"
    fi
}

init_skills() {
    local dir="$1"
    mkdir -p "$dir/.skills"

    [[ -f "$dir/.skills/bee.md" ]] || cp "$SCRIPT_DIR/skills/bee.md" "$dir/.skills/bee.md"
    [[ -f "$dir/.skills/queen.md" ]] || cp "$SCRIPT_DIR/skills/queen.md" "$dir/.skills/queen.md"
}

init_beads_metadata() {
    local dir="$1"
    local meta="$dir/plans/_meta"
    mkdir -p "$meta"

    # Sessions file is beehive-specific (not in beads)
    [[ -f "$meta/sessions.jsonl" ]] || touch "$meta/sessions.jsonl"

    # Initialize beads if not already present
    if [[ ! -d "$dir/.beads" ]]; then
        info "Initializing beads issue tracker..."
        (cd "$dir" && bd init --quiet) || die "bd init failed"
    fi
}

init_commands() {
    local dir="$1"
    mkdir -p "$dir/.claude/commands"

    for cmd in report buzz bedtime session-report deep-plan review board health; do
        [[ -f "$dir/.claude/commands/$cmd.md" ]] || cp "$SCRIPT_DIR/commands/$cmd.md" "$dir/.claude/commands/$cmd.md"
    done
}

init_gitignore() {
    local dir="$1"
    local gitignore="$dir/.gitignore"

    # If .gitignore doesn't exist, create from template
    if [[ ! -f "$gitignore" ]]; then
        cp "$SCRIPT_DIR/templates/gitignore" "$gitignore"
        return
    fi

    # Ensure .beads/ is in .gitignore
    if ! grep -q '\.beads/' "$gitignore" 2>/dev/null; then
        echo "" >> "$gitignore"
        echo "# Beads issue tracker (local database)" >> "$gitignore"
        echo ".beads/" >> "$gitignore"
    fi

    # Remove stale entries from old versions
    if grep -q '^\.hive/' "$gitignore" 2>/dev/null; then
        sed -i.bak '/^\.hive\//d' "$gitignore" && rm -f "$gitignore.bak"
    fi
    if grep -q 'plans/_meta/' "$gitignore" 2>/dev/null; then
        awk '
            $0 ~ /^plans\/\_meta\/claims\/$/ { next }
            { print }
        ' "$gitignore" > "$gitignore.tmp" && mv "$gitignore.tmp" "$gitignore"
    fi
}

init_template() {
    local dir="$1"

    [[ -f "$dir/plans/TEMPLATE.md" ]] || cp "$SCRIPT_DIR/templates/plan.md" "$dir/plans/TEMPLATE.md"
}

init_repo() {
    local dir="$1"
    mkdir -p "$dir/plans/completed"
    mkdir -p "$dir/plans/_meta"

    [[ ! -f "$dir/CLAUDE.md" ]] && cat > "$dir/CLAUDE.md" << 'EOF'
# Project Instructions for Claude

## Overview
<!-- Describe the project -->

## Agent Roles
- **Queen**: Owns super-swarms, critical path, Bee slot state, dispatch, and verification. Read `.skills/queen.md`
- **Bees**: Own scoped swarms and execute assigned beads. Read `.skills/bee.md`

## Coordination
This project uses **beads** (`bd`) for task tracking and coordination.
- Assigned executable beads are the plan; do not enter Claude plan mode for scoped work
- Queen reviews `bd ready`; Bees do not self-dispatch unless explicitly authorized
- `bd update <id> --claim` — claim only when Queen/free-pick allows it
- `bd close <id>` — mark complete with evidence
- `bd create` — create parented or source-linked issues/tasks
- `plans/` — archive only; new plans are Beads epics
- `plans/_meta/sessions.jsonl` — session metadata (Queen owns)

## Guidelines
- Ask approval before environment-impacting operations
- Bees report completion to Queen for verification
- Use /buzz, /report, /bedtime, /session-report, /deep-plan commands
EOF

    init_beads_metadata "$dir"
    init_skills "$dir"
    init_commands "$dir"
    init_template "$dir"
    init_gitignore "$dir"

    success "✓ Initialized: $dir"
    echo "  Run: beehive $dir"
}

init_workspace() {
    local dir="$1"
    mkdir -p "$dir/plans/completed"
    mkdir -p "$dir/plans/_meta"

    [[ ! -f "$dir/CLAUDE.md" ]] && {
        {
            echo "# Workspace Instructions"
            echo ""
            echo "Multi-repo workspace. All coordination via Beads."
            echo "When assigned a bead, cd to the target repo and read its CLAUDE.md."
            echo ""
            echo "## Repositories"
            echo "| Repository | Description |"
            echo "|------------|-------------|"
            for repo in "$dir"/*/; do
                [[ -d "$repo/.git" ]] && echo "| \`$(basename "$repo")/\` | <!-- describe --> |"
            done
            echo ""
            echo "## Agent Roles"
            echo "- **Queen**: Owns super-swarms, critical path, Bee slot state, dispatch, and verification. Read \`.skills/queen.md\`"
            echo "- **Bees**: Own scoped swarms and execute assigned beads. Read \`.skills/bee.md\`"
            echo ""
            echo "## Coordination"
            echo "This project uses **beads** (\`bd\`) for task tracking and coordination."
            echo "- Assigned executable beads are the plan; do not enter Claude plan mode for scoped work"
            echo "- Queen reviews \`bd ready\`; Bees do not self-dispatch unless explicitly authorized"
            echo "- \`bd update <id> --claim\` — claim only when Queen/free-pick allows it"
            echo "- \`bd close <id>\` — mark complete with evidence"
            echo "- \`bd create\` — create parented or source-linked issues/tasks"
            echo "- \`plans/\` — archive only; new plans are Beads epics"
            echo "- \`plans/_meta/sessions.jsonl\` — session metadata (Queen owns)"
            echo ""
            echo "## Guidelines"
            echo "- Ask approval before environment-impacting operations"
            echo "- Bees report completion to Queen for verification"
            echo "- Use /buzz, /report, /bedtime, /session-report, /deep-plan commands"
        } > "$dir/CLAUDE.md"
    }

    # Add CLAUDE.md to repos that don't have one
    for repo in "$dir"/*/; do
        [[ -d "$repo/.git" && ! -f "$repo/CLAUDE.md" ]] && {
            {
                echo "# $(basename "$repo")"
                echo ""
                echo "## Overview"
                echo "<!-- Describe this repo -->"
            } > "$repo/CLAUDE.md"
        }
    done

    init_beads_metadata "$dir"
    init_skills "$dir"
    init_commands "$dir"
    init_template "$dir"
    init_gitignore "$dir"

    success "✓ Initialized workspace: $dir"
    echo "  Run: beehive $dir"
}

queen_prompt_text() {
    local path="$1"
    printf "Read CLAUDE.md and .skills/queen.md. You are the Queen. Run 'bd -C %q prime' for workflow context. Follow your skill instructions. You own super-swarms, critical path, Bee slot state, and dispatch; Bees own scoped swarms. Use buzz for tactical dispatch refresh and session-report for maturity/unlocks/roadblocks. If this CLI rejects slash commands, treat buzz/board/health/report/bedtime/session-report/deep-plan/review as named procedures from .skills/.claude/commands and perform the equivalent bd comments/updates directly. Wait for user direction." "$path"
}

#######################################
# Launch agents
#######################################
do_queen_only() {
    local path="$1" queen_model="$2" cli_family="${3:-claude}"

    AGENT_CMD=$(resolve_cli_command "$cli_family" "$CLI_CMD_OVERRIDE") || die "Agent CLI '$cli_family' not found. Install it or set CONF_CLI_CMD/--cli-cmd."

    if [[ -n "$ANTHROPIC_BASE_URL" ]]; then
        if ! curl -sf --max-time 5 "${ANTHROPIC_BASE_URL}/health" > /dev/null 2>&1; then
            die "Cannot reach API proxy at $ANTHROPIC_BASE_URL/health — is it running?"
        fi
    fi

    [[ ! -f "$path/CLAUDE.md" ]] && die "Not initialized. Run: beehive --init $path"

    if (cd "$path" && bd context >/dev/null) 2>/dev/null; then
        success "  Beads context ready"
    else
        warn "Could not validate Beads context (Queen will report details from bd prime)"
    fi

    local prompt queen_cmd
    prompt=$(queen_prompt_text "$path")
    queen_cmd=$(build_pane_command "$prompt" "$queen_model" "queen")

    success "✓ Launching Queen only (no tmux)"
    cd "$path" || die "Could not cd to $path"
    eval "$queen_cmd"
}

do_launch() {
    local path="$1" bee_model="$2" queen_model="$3" num_bees="${4:-3}" launch_queen="${5:-true}" cli_family="${6:-claude}"
    local queen_panes=0
    [[ "$launch_queen" == "true" ]] && queen_panes=1
    local total_panes=$((num_bees + queen_panes))
    local mode
    mode=$(detect_mode "$path")

    # Config already loaded before confirmation

    # Resolve selected agent CLI
    AGENT_CMD=$(resolve_cli_command "$cli_family" "$CLI_CMD_OVERRIDE") || die "Agent CLI '$cli_family' not found. Install it or set CONF_CLI_CMD/--cli-cmd."

    # Check requirements
    command -v tmux &> /dev/null || die "tmux required. Install: brew install tmux"

    # Health check for custom API endpoint
    if [[ -n "$ANTHROPIC_BASE_URL" ]]; then
        if ! curl -sf --max-time 5 "${ANTHROPIC_BASE_URL}/health" > /dev/null 2>&1; then
            die "Cannot reach API proxy at $ANTHROPIC_BASE_URL/health — is it running?"
        fi
    fi

    [[ ! -f "$path/CLAUDE.md" ]] && die "Not initialized. Run: beehive --init $path"

    # Beads 1.0+ uses embedded Dolt by default; do not start a persistent server.
    if (cd "$path" && bd context >/dev/null) 2>/dev/null; then
        success "  Beads context ready"
    else
        warn "Could not validate Beads context (agents will report details from bd prime)"
    fi

    # Kill existing
    tmux kill-session -t "$SESSION_NAME" 2>/dev/null || true

    # Create session
    local clip
    clip=$(detect_clipboard)

    tmux new-session -d -s "$SESSION_NAME" -c "$path" -x 200 -y 50
    # Create remaining panes (session creation gives us pane 0)
    for (( i=1; i<total_panes; i++ )); do
        tmux split-window -t "$SESSION_NAME:0" -c "$path"
    done
    if [[ "$total_panes" -eq 2 ]]; then
        tmux select-layout -t "$SESSION_NAME" even-horizontal
    else
        tmux select-layout -t "$SESSION_NAME" tiled
    fi

    # Make tmux preserve rich CLI UIs (Codex/Cursor/Claude) instead of falling back
    # to a stripped-down terminal style.
    tmux set-option -t "$SESSION_NAME" -g default-terminal "tmux-256color"
    tmux set-option -t "$SESSION_NAME" -ga terminal-overrides ",*:Tc"
    tmux set-option -t "$SESSION_NAME" -g focus-events on
    tmux set-option -t "$SESSION_NAME" -g aggressive-resize on
    tmux set-option -t "$SESSION_NAME" -g status on
    tmux set-option -t "$SESSION_NAME" -g status-position bottom
    tmux set-option -t "$SESSION_NAME" -g status-style "bg=colour234,fg=colour250"
    tmux set-option -t "$SESSION_NAME" -g status-left-style "fg=colour220,bold"
    tmux set-option -t "$SESSION_NAME" -g status-left-length 40
    tmux set-option -t "$SESSION_NAME" -g status-left " 🐝 #S "
    tmux set-option -t "$SESSION_NAME" -g status-right-style "fg=colour245"
    tmux set-option -t "$SESSION_NAME" -g status-right " %H:%M "
    tmux set-window-option -t "$SESSION_NAME" -g window-status-current-style "bg=colour238,fg=colour220,bold"
    tmux set-window-option -t "$SESSION_NAME" -g mode-style "bg=colour238,fg=colour220,bold"
    tmux set-option -t "$SESSION_NAME" pane-border-status top
    tmux set-option -t "$SESSION_NAME" pane-border-format " #[fg=colour245]#[fg=colour234,bg=colour245,bold] #T #[fg=colour245,bg=default] "
    tmux set-option -t "$SESSION_NAME" -g pane-border-style "fg=colour238"
    tmux set-option -t "$SESSION_NAME" -g pane-active-border-style "fg=colour220,bold"
    tmux set-option -t "$SESSION_NAME" mouse on
    tmux set-option -t "$SESSION_NAME" -g set-clipboard on
    tmux bind-key -T copy-mode MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "$clip"
    tmux bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "$clip"

    # Name panes: bees 0..num_bees-1, optional queen at num_bees
    for (( i=0; i<num_bees; i++ )); do
        local bee_num=$((i + 1))
        tmux select-pane -t "$SESSION_NAME:0.$i" -T "🐝 Bee $bee_num"
    done
    if [[ "$launch_queen" == "true" ]]; then
        tmux select-pane -t "$SESSION_NAME:0.$num_bees" -T "🐝 Queen"
    fi

    # Prompts - agents read their skill files and use bd for coordination
    local bee_prompt="Read CLAUDE.md and .skills/bee.md. You are Bee %d. Run 'bd -C %q prime'. Then run 'bd -C %q list --assignee bee-%d'. If assigned work exists, show the current executable bead and execute it; the bead is the plan. Do not self-dispatch from bd ready, create plans, or mutate live systems without an accepted intention gate. If no assignment or scope is unclear, report idle/blocked or PRE-WORK to Queen. If this CLI rejects slash commands, treat buzz/report/bedtime as named procedures from .skills/.claude/commands and perform the equivalent bd comments/updates directly."

    local queen_prompt
    queen_prompt=$(queen_prompt_text "$path")

    # Launch bees with bee_model and BD_ACTOR identity
    for (( i=0; i<num_bees; i++ )); do
        local prompt
        local bee_num=$((i + 1))
        # shellcheck disable=SC2059
        printf -v prompt "$bee_prompt" "$bee_num" "$path" "$path" "$bee_num"
        local pane_cmd
        pane_cmd=$(build_pane_command "$prompt" "$bee_model" "bee-$bee_num")
        tmux send-keys -t "$SESSION_NAME:0.$i" "$pane_cmd" Enter
        sleep 1
    done

    # Launch optional queen with queen_model and BD_ACTOR identity
    if [[ "$launch_queen" == "true" ]]; then
        local queen_cmd
        queen_cmd=$(build_pane_command "$queen_prompt" "$queen_model" "queen")
        tmux send-keys -t "$SESSION_NAME:0.$num_bees" "$queen_cmd" Enter
        tmux select-pane -t "$SESSION_NAME:0.$num_bees"
    else
        tmux select-pane -t "$SESSION_NAME:0.0"
    fi

    echo ""
    if [[ "$launch_queen" == "true" ]]; then
        success "✓ Launched $total_panes agents ($num_bees bees + Queen)"
    else
        success "✓ Launched $total_panes agents ($num_bees bees, no Queen)"
    fi
    echo ""
    if [[ "$num_bees" -eq 2 ]]; then
        if [[ "$launch_queen" == "true" ]]; then
            echo "  ┌──────────┬──────────┐"
            echo "  │ 🐝 Bee 1 │ 🐝 Bee 2 │"
            echo "  ├──────────┴──────────┤"
            echo "  │      🐝 Queen       │"
            echo "  └─────────────────────┘"
        else
            echo "  ┌──────────┬──────────┐"
            echo "  │ 🐝 Bee 1 │ 🐝 Bee 2 │"
            echo "  └──────────┴──────────┘"
        fi
    elif [[ "$num_bees" -eq 3 ]]; then
        if [[ "$launch_queen" == "true" ]]; then
            echo "  ┌──────────┬──────────┐"
            echo "  │ 🐝 Bee 1 │ 🐝 Bee 2 │"
            echo "  ├──────────┼──────────┤"
            echo "  │ 🐝 Bee 3 │ 🐝 Queen │"
            echo "  └──────────┴──────────┘"
        else
            echo "  ┌──────────┬──────────┬──────────┐"
            echo "  │ 🐝 Bee 1 │ 🐝 Bee 2 │ 🐝 Bee 3 │"
            echo "  └──────────┴──────────┴──────────┘"
        fi
    elif [[ "$num_bees" -eq 4 ]]; then
        if [[ "$launch_queen" == "true" ]]; then
            echo "  ┌──────────┬──────────┐"
            echo "  │ 🐝 Bee 1 │ 🐝 Bee 2 │"
            echo "  ├──────────┼──────────┤"
            echo "  │ 🐝 Bee 3 │ 🐝 Bee 4 │"
            echo "  ├──────────┴──────────┤"
            echo "  │      🐝 Queen       │"
            echo "  └─────────────────────┘"
        else
            echo "  ┌──────────┬──────────┐"
            echo "  │ 🐝 Bee 1 │ 🐝 Bee 2 │"
            echo "  ├──────────┼──────────┤"
            echo "  │ 🐝 Bee 3 │ 🐝 Bee 4 │"
            echo "  └──────────┴──────────┘"
        fi
    elif [[ "$num_bees" -eq 5 ]]; then
        if [[ "$launch_queen" == "true" ]]; then
            echo "  ┌──────────┬──────────┬──────────┐"
            echo "  │ 🐝 Bee 1 │ 🐝 Bee 2 │ 🐝 Bee 3 │"
            echo "  ├──────────┼──────────┼──────────┤"
            echo "  │ 🐝 Bee 4 │ 🐝 Bee 5 │ 🐝 Queen │"
            echo "  └──────────┴──────────┴──────────┘"
        else
            echo "  ┌──────────┬──────────┬──────────┐"
            echo "  │ 🐝 Bee 1 │ 🐝 Bee 2 │ 🐝 Bee 3 │"
            echo "  ├──────────┴──────────┼──────────┤"
            echo "  │ 🐝 Bee 4            │ 🐝 Bee 5 │"
            echo "  └─────────────────────┴──────────┘"
        fi
    fi
    echo ""
    echo "  Ctrl+B, D  Detach (keeps running)"
    echo "  Ctrl+B, z  Zoom pane"
    echo ""

    sleep 1
    tmux attach-session -t "$SESSION_NAME"
}

#######################################
# Upgrade existing project
#######################################
do_upgrade() {
    local path="$1"

    # Must already be initialized
    [[ ! -d "$path/plans" ]] && die "Not initialized. Run: beehive --init $path"

    if $DRY_RUN; then
        echo ""
        echo -e "${GREEN}Beehive Upgrade (dry run)${NC} — $(basename "$path")"
        echo ""
        echo "  Would overwrite:"
        echo "    .skills/bee.md"
        echo "    .skills/queen.md"
        for cmd in report buzz bedtime session-report deep-plan review board health; do
            [[ -f "$SCRIPT_DIR/commands/$cmd.md" ]] && echo "    .claude/commands/$cmd.md"
        done
        echo "    plans/TEMPLATE.md"
        echo ""
        echo "  Would remove (if present):"
        [[ -f "$path/.claude/commands/sting.md" ]] && echo "    .claude/commands/sting.md"
        [[ -f "$path/.claude/commands/refresh.md" ]] && echo "    .claude/commands/refresh.md"
        [[ -f "$path/WORKSPACE.md" ]] && echo "    WORKSPACE.md → plans/_meta/migrated/"
        echo ""
        echo "  Would initialize (if missing):"
        [[ ! -d "$path/.beads" ]] && echo "    .beads/ (beads issue tracker)"
        [[ ! -f "$path/plans/_meta/sessions.jsonl" ]] && echo "    plans/_meta/sessions.jsonl"
        echo ""

        # Check legacy markdown migration (v0.2.x-v0.4.x → beads)
        _migrate_markdown_to_beads "$path"

        [[ -f "$path/0.5.0_PRE_RELEASE_FEEDBACK.md" ]] && echo "  Would remove: 0.5.0_PRE_RELEASE_FEEDBACK.md"
        [[ -f "$path/plans/_review_prompt.md" ]] && echo "  Would remove: plans/_review_prompt.md"


        if [[ -e "$path/templates/schemas.md" ]]; then
            echo "  Would remove: templates/schemas.md"
        fi

        if [[ -f "$path/0.5.0_PRE_RELEASE_FEEDBACK.md" ]]; then
            echo ""
            warn "Release artifact present: 0.5.0_PRE_RELEASE_FEEDBACK.md"
        fi

        echo ""
        info "No changes made (dry run)."
        return
    fi

    info "Upgrading beehive files in: $path"

    # Upgrade skills (overwrite)
    mkdir -p "$path/.skills"
    cp "$SCRIPT_DIR/skills/bee.md" "$path/.skills/bee.md"
    cp "$SCRIPT_DIR/skills/queen.md" "$path/.skills/queen.md"

    # Upgrade commands (overwrite)
    mkdir -p "$path/.claude/commands"
    for cmd in report buzz bedtime session-report deep-plan review board health; do
        [[ -f "$SCRIPT_DIR/commands/$cmd.md" ]] && cp "$SCRIPT_DIR/commands/$cmd.md" "$path/.claude/commands/$cmd.md"
    done

    # Clean up removed commands
    rm -f "$path/.claude/commands/sting.md"
    rm -f "$path/.claude/commands/refresh.md"

    # Clean up removed workspace file (v0.4.0 → v0.5.0)
    if [[ -f "$path/WORKSPACE.md" ]]; then
        mkdir -p "$path/plans/_meta/migrated"
        mv "$path/WORKSPACE.md" "$path/plans/_meta/migrated/"
    fi

    # Upgrade plan template (overwrite)
    cp "$SCRIPT_DIR/templates/plan.md" "$path/plans/TEMPLATE.md"

    # Initialize beads + sessions metadata (idempotent)
    init_beads_metadata "$path"

    # Migrate legacy markdown tracking directly to beads
    _migrate_markdown_to_beads "$path"

    # Clean up removed files/dirs
    rm -f "$path/templates/schemas.md" 2>/dev/null || true
    rm -f "$path/0.5.0_PRE_RELEASE_FEEDBACK.md" 2>/dev/null || true
    rm -f "$path/plans/_review_prompt.md" 2>/dev/null || true


    # Update gitignore
    init_gitignore "$path"

    success "✓ Upgraded to v$VERSION"
    echo "  Skills, commands, and template updated."
    echo "  Beads issue tracker initialized."
    echo ""
    echo "  Review changes:"
    echo "    .skills/bee.md, .skills/queen.md"
    echo "    .claude/commands/*"
    echo "    plans/TEMPLATE.md"
    echo "    .beads/ (issue tracker database)"
}

_migrate_markdown_to_beads() {
    local path="$1"
    local meta="$path/plans/_meta"
    local migrated="$meta/migrated"
    local tracker_file=""

    if [[ -f "$meta/TRACKER.md" ]]; then
        tracker_file="$meta/TRACKER.md"
    elif [[ -f "$path/plans/TRACKER.md" ]]; then
        tracker_file="$path/plans/TRACKER.md"
    elif [[ -f "$path/TRACKER.md" ]]; then
        tracker_file="$path/TRACKER.md"
    fi

    if $DRY_RUN; then
        local would_migrate=false
        [[ -n "$tracker_file" ]] && would_migrate=true
        [[ -d "$path/.hive" ]] && would_migrate=true
        [[ -f "$path/plans/INBOX.md" ]] && would_migrate=true
        [[ -f "$meta/SESSION_LOG.md" ]] && would_migrate=true
        [[ -f "$meta/DEPENDENCIES.md" ]] && would_migrate=true
        $would_migrate || return 0

        echo "  Would migrate:"
        if [[ -n "$tracker_file" ]]; then
            local active_count=0 completed_count=0 section=""
            while IFS= read -r line; do
                [[ "$line" == *"## Active"* ]] && { section="active"; continue; }
                [[ "$line" == *"## Completed"* ]] && { section="completed"; continue; }
                [[ "$line" == "## "* ]] && { section=""; continue; }
                [[ "$line" == "|--"* || "$line" == "| Plan "* || "$line" == "###"* || -z "$line" ]] && continue
                [[ "$line" != \|* ]] && continue
                [[ "$section" == "active" ]] && active_count=$((active_count + 1))
                [[ "$section" == "completed" ]] && completed_count=$((completed_count + 1))
            done < "$tracker_file"
            echo "    TRACKER.md → beads ($active_count active, $completed_count completed)"
            echo "    id-mapping.json → plans/_meta/migrated/"
            echo "    Note: relationships are not imported from TRACKER.md"
        fi
        [[ -d "$path/.hive" ]] && echo "    .hive/ → plans/_meta/migrated/"
        [[ -f "$path/plans/INBOX.md" ]] && echo "    INBOX.md → plans/_meta/migrated/"
        [[ -f "$meta/SESSION_LOG.md" ]] && echo "    SESSION_LOG.md → plans/_meta/migrated/"
        [[ -f "$meta/DEPENDENCIES.md" ]] && echo "    DEPENDENCIES.md → plans/_meta/migrated/"
        return 0
    fi

    local existing_count
    existing_count=$(cd "$path" && bd list --json --all 2>/dev/null | jq 'length' 2>/dev/null || echo "0")
    if [[ "$existing_count" -gt 0 ]]; then
        info "  Beads already has issues; skipping tracker migration"
        return 0
    fi

    local needs_archive=false
    [[ -n "$tracker_file" ]] && needs_archive=true
    [[ -d "$path/.hive" ]] && needs_archive=true
    [[ -f "$path/plans/INBOX.md" ]] && needs_archive=true
    [[ -f "$meta/SESSION_LOG.md" ]] && needs_archive=true
    [[ -f "$meta/DEPENDENCIES.md" ]] && needs_archive=true
    $needs_archive || return 0

    mkdir -p "$migrated"

    local report_lines=()
    _report() { report_lines+=("$1"); }
    _strip_md() { echo "$1" | sed 's/\*\*//g; s/\[\([^]]*\)\]([^)]*)/\1/g'; }
    _parse_tracker_cells() {
        printf '%s\n' "$1" | awk -F'|' '{
            n=0; out=""
            for(i=2; i<NF; i++) {
                gsub(/^[ \t]+|[ \t]+$/, "", $i)
                if(n>0) out=out"\t"
                out=out $i; n++
            }
            if(n>0) print out; else exit 1
        }'
    }

    local tracker_copy=""
    if [[ -n "$tracker_file" ]]; then
        tracker_copy="$migrated/$(basename "$tracker_file")"
        cp "$tracker_file" "$tracker_copy"
        _report "- TRACKER.md found at: \`$tracker_file\`"
    fi
    [[ -d "$path/.hive" && ! -e "$migrated/.hive" ]] && cp -R "$path/.hive" "$migrated/.hive"
    [[ -f "$path/plans/INBOX.md" && ! -e "$migrated/INBOX.md" ]] && cp "$path/plans/INBOX.md" "$migrated/INBOX.md"
    [[ -f "$meta/SESSION_LOG.md" && ! -e "$migrated/SESSION_LOG.md" ]] && cp "$meta/SESSION_LOG.md" "$migrated/SESSION_LOG.md"
    [[ -f "$meta/DEPENDENCIES.md" && ! -e "$migrated/DEPENDENCIES.md" ]] && cp "$meta/DEPENDENCIES.md" "$migrated/DEPENDENCIES.md"

    local migrate_count=0 archive_count=0
    local id_map='{}'

    if [[ -n "$tracker_file" ]]; then
        local section=""
        while IFS= read -r line; do
            [[ "$line" == *"## Active"* ]] && { section="active"; continue; }
            [[ "$line" == *"## Completed"* ]] && { section="completed"; continue; }
            [[ "$line" == "## "* ]] && { section=""; continue; }
            [[ "$line" == "|--"* ]] && continue
            [[ "$line" == "| Plan |"* ]] && continue
            [[ "$line" == "###"* ]] && continue
            [[ -z "$line" ]] && continue
            [[ "$line" != \|* ]] && continue

            if [[ "$section" == "active" ]]; then
                local plan status priority summary cells col_count old_id bd_priority new_id bd_status
                cells=$(_parse_tracker_cells "$line") || {
                    _report "- Skipped unparseable row: $(echo "$line" | head -c 60)..."
                    continue
                }
                col_count=$(printf '%s\n' "$cells" | awk -F'\t' '{print NF}')
                if [[ "$col_count" -lt 4 ]]; then
                    _report "- Skipped unparseable row: $(echo "$line" | head -c 60)..."
                    continue
                fi

                plan=$(_strip_md "$(printf '%s\n' "$cells" | awk -F'\t' '{print $1}')")
                status=$(_strip_md "$(printf '%s\n' "$cells" | awk -F'\t' '{print $2}')")
                priority=$(_strip_md "$(printf '%s\n' "$cells" | awk -F'\t' '{print $3}')")
                summary=$(_strip_md "$(printf '%s\n' "$cells" | awk -F'\t' '{print $4}')")
                [[ -z "$plan" ]] && continue

                status=$(echo "$status" | awk '{print tolower($1)}' | sed 's/^[ 	]*//;s/[ 	]*$//')
                case "$status" in
                    ready|pending) bd_status="open" ;;
                    working|near-complete|in) bd_status="in_progress" ;;
                    blocked|deferred) bd_status="blocked" ;;
                    done|archived|complete|completed|finished) bd_status="closed" ;;
                    *) _report "- \`$plan\`: status \`$status\` unrecognized, defaulted to open"; bd_status="open" ;;
                esac

                case "$(echo "$priority" | tr '[:upper:]' '[:lower:]')" in
                    critical|crit|high|hi) bd_priority=1 ;;
                    medium|med|low|lo) bd_priority=2 ;;
                    reference|ref) bd_priority=3 ;;
                    *) bd_priority=2 ;;
                esac

                old_id="P-$(printf '%03d' $((migrate_count + archive_count + 1)))"
                if [[ -n "$summary" && "$summary" != "-" ]]; then
                    new_id=$(cd "$path" && bd create "$plan" --type epic -p "$bd_priority" --description "$summary" --json | jq -r '.id')
                else
                    new_id=$(cd "$path" && bd create "$plan" --type epic -p "$bd_priority" --description "Migrated from TRACKER.md" --json | jq -r '.id')
                fi

                if [[ "$bd_status" == "closed" ]]; then
                    (cd "$path" && bd close "$new_id" --reason "Migrated as done" --quiet) >/dev/null 2>&1 || true
                elif [[ "$bd_status" == "in_progress" ]]; then
                    (cd "$path" && bd update "$new_id" --status in_progress --quiet) >/dev/null 2>&1 || true
                elif [[ "$bd_status" == "blocked" ]]; then
                    (cd "$path" && bd update "$new_id" --status blocked --quiet) >/dev/null 2>&1 || true
                fi

                id_map=$(echo "$id_map" | jq --arg old "$old_id" --arg new "$new_id" '. + {($old): $new}')
                migrate_count=$((migrate_count + 1))
            elif [[ "$section" == "completed" ]]; then
                local plan summary cells old_id new_id
                local col_count
                cells=$(_parse_tracker_cells "$line") || {
                    _report "- Skipped unparseable row: $(echo "$line" | head -c 60)..."
                    continue
                }
                col_count=$(printf '%s\n' "$cells" | awk -F'\t' '{print NF}')
                if [[ "$col_count" -lt 2 ]]; then
                    _report "- Skipped unparseable row: $(echo "$line" | head -c 60)..."
                    continue
                fi

                plan=$(_strip_md "$(printf '%s\n' "$cells" | awk -F'\t' '{print $1}')")
                summary=$(_strip_md "$(printf '%s\n' "$cells" | awk -F'\t' '{print $2}')")
                [[ -z "$plan" ]] && continue

                old_id="P-$(printf '%03d' $((migrate_count + archive_count + 1)))"
                if [[ -n "$summary" && "$summary" != "-" ]]; then
                    new_id=$(cd "$path" && bd create "$plan" --type epic -p 3 --description "$summary" --json | jq -r '.id')
                else
                    new_id=$(cd "$path" && bd create "$plan" --type epic -p 3 --description "Migrated from archive" --json | jq -r '.id')
                fi
                (cd "$path" && bd close "$new_id" --reason "Archived (migrated)" --quiet) >/dev/null 2>&1 || true
                id_map=$(echo "$id_map" | jq --arg old "$old_id" --arg new "$new_id" '. + {($old): $new}')
                archive_count=$((archive_count + 1))
            fi
        done < "$tracker_file"

        mv "$tracker_file" "$migrated/"
    fi

    if [[ -d "$path/.hive" ]]; then
        rm -rf "$migrated/.hive" 2>/dev/null || true
        mv "$path/.hive" "$migrated/"
    fi
    [[ -f "$path/plans/INBOX.md" ]] && mv "$path/plans/INBOX.md" "$migrated/"
    [[ -f "$meta/SESSION_LOG.md" ]] && mv "$meta/SESSION_LOG.md" "$migrated/"
    [[ -f "$meta/DEPENDENCIES.md" ]] && mv "$meta/DEPENDENCIES.md" "$migrated/"

    echo "$id_map" | jq '.' > "$migrated/id-mapping.json"

    {
        echo "# Migration Report"
        echo ""
        echo "**Date:** $(date +%Y-%m-%d)"
        echo "**Beehive version:** v$VERSION"
        echo "**Source:** markdown tracker files"
        echo "**Target:** beads issues"
        echo ""
        echo "## Summary"
        echo ""
        echo "- Active work items migrated to beads: $migrate_count"
        echo "- Completed items migrated to beads: $archive_count"
        echo "- Original files preserved in: \`plans/_meta/migrated/\`"
        echo "- relationships not imported from TRACKER.md"
        echo ""
        if [[ ${#report_lines[@]} -gt 0 ]]; then
            echo "## Fallbacks and Warnings"
            echo ""
            for line in "${report_lines[@]}"; do
                echo "$line"
            done
            echo ""
        fi
        echo "## Originals"
        echo ""
        for f in "$migrated"/*; do
            [[ -e "$f" ]] && echo "- \`$(basename "$f")\`"
        done
    } > "$migrated/migration-report.md"

    success "  Migrated legacy tracking files to beads"
    info "  ID mapping: plans/_meta/migrated/id-mapping.json"
    info "  Migration report: plans/_meta/migrated/migration-report.md"
}

#######################################
# Status display (beads-backed)
#######################################
do_status() {
    local path="$1"

    [[ ! -d "$path/plans" ]] && die "Not initialized. Run: beehive --init $path"
    [[ ! -d "$path/.beads" ]] && die "Beads not initialized. Run: beehive --init $path"

    if $JSON_OUTPUT; then
        _do_status_json "$path"
    else
        _do_status_human "$path"
    fi
}

_do_status_json() {
    local path="$1"

    # Get all issues from beads
    local all_issues
    all_issues=$(cd "$path" && bd list --json --all 2>/dev/null || echo "[]")

    local ready_issues
    ready_issues=$(cd "$path" && bd ready --json 2>/dev/null || echo "[]")

    # Build agents list from assignee field
    local agents
    agents=$(echo "$all_issues" | jq '[.[] | select(.assignee != null and .assignee != "") | {agent: .assignee, status: .status, item_id: .id, title: .title}] | group_by(.agent) | map({agent: .[0].agent, items: .})')

    # Output combined JSON
    jq -cn \
        --arg project "$(basename "$path")" \
        --argjson issues "$all_issues" \
        --argjson ready "$ready_issues" \
        --argjson agents "$agents" \
        '{project:$project, issues:$issues, ready:$ready, agents:$agents}'
}

_do_status_human() {
    local path="$1"

    echo ""
    echo -e "${GREEN}Beehive Status${NC} — $(basename "$path")"

    # All open issues
    echo ""
    echo -e "${CYAN}  Work Items${NC}"
    local issues
    issues=$(cd "$path" && bd list --json 2>/dev/null || echo "[]")
    local count
    count=$(echo "$issues" | jq 'length')

    if [[ "$count" -eq 0 ]]; then
        echo "  (none)"
    else
        echo "$issues" | jq -r '.[] | "  \(if .status == "open" then "○" elif .status == "in_progress" then "●" elif .status == "blocked" then "✕" else "·" end) \(.id) \(.status) P\(.priority) \(.title)\(if .assignee != null and .assignee != "" then " [\(.assignee)]" else "" end)"'
    fi

    # Agent assignments
    echo ""
    echo -e "${CYAN}  Agents${NC}"
    local assigned
    assigned=$(echo "$issues" | jq -r '.[] | select(.assignee != null and .assignee != "") | "\(.assignee)\t\(.status)\t\(.id)\t\(.title)"' 2>/dev/null)
    if [[ -z "$assigned" ]]; then
        echo "  (no active assignments)"
    else
        echo "$assigned" | while IFS=$'\t' read -r agent status item_id title; do
            printf "  %-10s %s %s %s\n" "$agent" "$status" "$item_id" "$title"
        done
    fi

    # Ready work (unblocked, unassigned)
    echo ""
    echo -e "${CYAN}  Ready${NC}"
    local ready
    ready=$(cd "$path" && bd ready --json 2>/dev/null || echo "[]")
    local ready_count
    ready_count=$(echo "$ready" | jq 'length')
    if [[ "$ready_count" -eq 0 ]]; then
        echo "  (none — all work assigned or blocked)"
    else
        echo "$ready" | jq -r '.[] | "  ◎ \(.id) P\(.priority) \(.title)"'
    fi

    echo ""
}

#######################################
# Validate project health
#######################################
do_validate() {
    local path="$1"
    local errors=0

    [[ ! -d "$path/plans" ]] && die "Not initialized. Run: beehive --init $path"
    [[ ! -d "$path/.beads" ]] && die "Beads not initialized. Run: beehive --init $path"

    echo ""
    echo -e "${GREEN}Beehive Validate${NC} — $(basename "$path")"
    echo ""

    # Check bd health
    local doctor_output doctor_status=0
    if ! doctor_output=$(cd "$path" && bd list --json --all >/dev/null 2>&1 && bd doctor 2>&1); then
        doctor_status=$?
    fi
    if [[ $doctor_status -eq 0 ]]; then
        echo -e "  ${GREEN}✓${NC} bd doctor: healthy"
    else
        echo -e "  ${RED}✕${NC} bd doctor: issues found"
        echo "$doctor_output" | sed 's/^/    /'
        errors=$((errors + 1))
    fi

    # Validate sessions.jsonl if present
    local meta="$path/plans/_meta"
    if [[ -s "$meta/sessions.jsonl" ]]; then
        local line_num=0
        local sess_errors=0
        while IFS= read -r line; do
            line_num=$((line_num + 1))
            [[ -z "$line" ]] && continue
            if ! echo "$line" | jq empty 2>/dev/null; then
                echo -e "  ${RED}✕${NC} sessions.jsonl:$line_num — invalid JSON"
                sess_errors=$((sess_errors + 1))
            fi
        done < "$meta/sessions.jsonl"
        if [[ "$sess_errors" -eq 0 ]]; then
            echo -e "  ${GREEN}✓${NC} sessions.jsonl: $line_num lines OK"
        else
            errors=$((errors + sess_errors))
        fi
    else
        echo -e "  ${GREEN}✓${NC} sessions.jsonl: empty (OK)"
    fi

    # Check issue counts
    local issue_counts total_count open_count in_progress_count blocked_count closed_count other_count
    issue_counts=$(cd "$path" && bd list --json --all 2>/dev/null | jq -r '
        reduce .[] as $issue (
            {total: 0, open: 0, in_progress: 0, blocked: 0, closed: 0, other: 0};
            .total += 1 |
            if $issue.status == "open" then .open += 1
            elif $issue.status == "in_progress" then .in_progress += 1
            elif $issue.status == "blocked" then .blocked += 1
            elif $issue.status == "closed" then .closed += 1
            else .other += 1
            end
        ) | "\(.total) \(.open) \(.in_progress) \(.blocked) \(.closed) \(.other)"')
    read -r total_count open_count in_progress_count blocked_count closed_count other_count <<< "$issue_counts"
    echo -e "  ${GREEN}✓${NC} issues: $total_count total ($open_count open, $in_progress_count in_progress, $blocked_count blocked, $closed_count closed, $other_count other)"

    echo ""
    if [[ $errors -eq 0 ]]; then
        success "✓ Validation passed (0 errors)"
        return 0
    else
        echo -e "${RED}✕ Validation failed ($errors errors)${NC}"
        return 1
    fi
}

#######################################
# Stop legacy persistent beads server
#######################################
do_stop() {
    local path="$1"
    [[ ! -d "$path/.beads" ]] && die "No beads database found in $path"

    info "Beehive no longer starts a persistent Beads server for Beads 1.0+ embedded mode."
    info "If a legacy Dolt server is running, stop it manually from the workspace with: bd dolt stop"
}

usage() {
    cat << EOF
Usage: beehive [options] [path]

Orchestrate multiple CLI-backed coding agents in tmux.

Commands:
    beehive [path]              Launch agents (default: current directory)
    beehive --init [path]       Initialize repo/workspace structure
    beehive --upgrade [path]    Upgrade skills, commands, and template (preserves data)
    beehive --status [path]     Show work items, agent states, and ready queue
    beehive --validate [path]   Validate beads health and sessions.jsonl
    beehive --stop [path]       Stop the persistent beads server

Options:
    --session NAME       Session name (default: folder name)
    --model MODEL        Anthropic model override (all agents)
    --bee-model MODEL    Model override for all Bees
    --queen-model MODEL  Model override for Queen
    --cli NAME           Agent CLI family: claude, codex, cursor (default: claude)
    --cli-cmd CMD        Explicit command/path for selected CLI
    --approval-mode MODE Approval handling: auto or manual (default: auto)
    --bees N             Number of Bees (2-5, default: 3)
    --no-queen           Launch only Bees; use when Queen runs separately
    --queen-only         Launch one Queen directly without tmux
    --profile PROF       AWS profile for Bedrock
    --region REGION      AWS region for Bedrock
    --base-url URL       Anthropic API base URL (for API proxies)
    --api-key KEY        Anthropic API key
    --dry-run            Preview upgrade changes without modifying files
    --json               Machine-readable JSON output for --status
    --yes                Skip confirmation
    --version            Show version
    --help               Show this help

Examples:
    beehive                      # Run in current directory
    beehive ~/myproject          # Run in specific path
    beehive --init ~/projects    # Initialize (auto-detects workspace vs repo)
    beehive --upgrade            # Upgrade skills/commands/template to latest
    beehive --upgrade --dry-run  # Preview what upgrade would change
    beehive --status --json      # Machine-readable status for CI/scripts
    beehive --validate           # Check beads health and sessions metadata
    beehive --base-url http://localhost:8090 --api-key sk-ant-xxx --yes
    beehive --queen-model claude-opus-4-6 --bee-model claude-sonnet-4-6
    beehive --cli codex              # Launch with Codex CLI
    beehive --cli codex --approval-mode manual
    beehive --cli cursor             # Launch with Cursor CLI (agent command)
    beehive --queen-only             # Launch one Queen directly, no tmux
    beehive --bees 2                 # Launch 2 bees + Queen (3 agents total)
    beehive --bees 5                 # Launch 5 bees + Queen (6 agents total)
    beehive --bees 2 --no-queen      # Launch 2 bees only; Queen runs elsewhere

EOF
    exit 0
}

#######################################
# Main
#######################################
main() {
    local cmd=""
    local path=""
    local skip_confirm=false
    DRY_RUN=false
    JSON_OUTPUT=false

    # CLI overrides (resolved later via resolve_setting)
    local CLI_SESSION_NAME="" CLI_MODEL=""
    local CLI_MODEL_BEE="" CLI_MODEL_QUEEN=""
    local CLI_AWS_PROFILE="" CLI_AWS_REGION=""
    local CLI_ANTHROPIC_BASE_URL="" CLI_ANTHROPIC_API_KEY=""
    local CLI_BEES="" CLI_QUEEN="" CLI_QUEEN_ONLY="" CLI_CLI="" CLI_CMD_OVERRIDE="" CLI_APPROVAL_MODE=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --init)         cmd="init"; shift ;;
            --upgrade)      cmd="upgrade"; shift ;;
            --status)       cmd="status"; shift ;;
            --validate)     cmd="validate"; shift ;;
            --stop)         cmd="stop"; shift ;;
            --dry-run)      DRY_RUN=true; shift ;;
            --json)         JSON_OUTPUT=true; shift ;;
            --session)      [[ -z "${2:-}" || "${2:-}" == -* ]] && die "--session requires a value"; CLI_SESSION_NAME="$2"; shift 2 ;;
            --model)        [[ -z "${2:-}" || "${2:-}" == -* ]] && die "--model requires a value"; CLI_MODEL="$2"; shift 2 ;;
            --bee-model)    [[ -z "${2:-}" || "${2:-}" == -* ]] && die "--bee-model requires a value"; CLI_MODEL_BEE="$2"; shift 2 ;;
            --queen-model)  [[ -z "${2:-}" || "${2:-}" == -* ]] && die "--queen-model requires a value"; CLI_MODEL_QUEEN="$2"; shift 2 ;;
            --profile)      [[ -z "${2:-}" || "${2:-}" == -* ]] && die "--profile requires a value"; CLI_AWS_PROFILE="$2"; shift 2 ;;
            --region)       [[ -z "${2:-}" || "${2:-}" == -* ]] && die "--region requires a value"; CLI_AWS_REGION="$2"; shift 2 ;;
            --base-url)     [[ -z "${2:-}" ]] && die "--base-url requires a value"; CLI_ANTHROPIC_BASE_URL="$2"; shift 2 ;;
            --api-key)      [[ -z "${2:-}" ]] && die "--api-key requires a value"; CLI_ANTHROPIC_API_KEY="$2"; shift 2 ;;
            --cli)          [[ -z "${2:-}" || "${2:-}" == -* ]] && die "--cli requires one of: claude, codex, cursor"; CLI_CLI="$2"; shift 2 ;;
            --cli-cmd)      [[ -z "${2:-}" || "${2:-}" == -* ]] && die "--cli-cmd requires a command path/name"; CLI_CMD_OVERRIDE="$2"; shift 2 ;;
            --approval-mode) [[ -z "${2:-}" || "${2:-}" == -* ]] && die "--approval-mode requires auto or manual"; CLI_APPROVAL_MODE="$2"; shift 2 ;;
            --bees)         [[ -z "${2:-}" || "${2:-}" == -* ]] && die "--bees requires a number (2-5)"; CLI_BEES="$2"; shift 2 ;;
            --no-queen)     CLI_QUEEN="false"; shift ;;
            --queen-only)   CLI_QUEEN_ONLY="true"; shift ;;
            --yes|-y)       skip_confirm=true; shift ;;
            --version)      echo "beehive v$VERSION"; exit 0 ;;
            --help|-h)      usage ;;
            -*)             die "Unknown option: $1" ;;
            *)              path="$1"; shift ;;
        esac
    done

    # Require jq for all commands (--help/--version exit above before reaching here)
    require_jq
    require_bd

    path="${path:-$(pwd)}"
    [[ ! -d "$path" ]] && die "Directory not found: $path"

    case "$cmd" in
        init) do_init "$path" ;;
        upgrade) do_upgrade "$path" ;;
        status) do_status "$path" ;;
        validate) do_validate "$path" ;;
        stop) do_stop "$path" ;;
        *)
            echo ""
            echo -e "${GREEN}Beehive${NC} v$VERSION"
            echo ""

            local mode
            mode=$(detect_mode "$path")

            # Load config early to show settings
            load_config "$path" || true

            # Resolve all settings: CLI → config (with role-specific precedence)
            # These are set as globals for do_launch() and build_pane_command()
            SESSION_NAME=$(resolve_setting "$CLI_SESSION_NAME" "" "$CONF_SESSION" "$(basename "$path")")
            AWS_PROFILE=$(resolve_setting "$CLI_AWS_PROFILE" "" "$CONF_AWS_PROFILE" "")
            AWS_REGION=$(resolve_setting "$CLI_AWS_REGION" "" "$CONF_AWS_REGION" "")
            ANTHROPIC_BASE_URL=$(resolve_setting "$CLI_ANTHROPIC_BASE_URL" "" "$CONF_ANTHROPIC_BASE_URL" "")
            ANTHROPIC_API_KEY=$(resolve_setting "$CLI_ANTHROPIC_API_KEY" "" "$CONF_ANTHROPIC_API_KEY" "")

            local bee_model queen_model
            bee_model=$(resolve_setting "$CLI_MODEL_BEE" "$CLI_MODEL" "$CONF_MODEL_BEE" "$CONF_MODEL")
            queen_model=$(resolve_setting "$CLI_MODEL_QUEEN" "$CLI_MODEL" "$CONF_MODEL_QUEEN" "$CONF_MODEL")

            local cli_family
            cli_family=$(resolve_setting "$CLI_CLI" "" "$CONF_CLI" "claude")
            [[ "$cli_family" == "claude" || "$cli_family" == "codex" || "$cli_family" == "cursor" ]] || die "--cli/CONF_CLI must be claude, codex, or cursor (got: $cli_family)"
            CLI_CMD_OVERRIDE=$(resolve_setting "$CLI_CMD_OVERRIDE" "" "$CONF_CLI_CMD" "")

            local approval_mode
            approval_mode=$(resolve_setting "$CLI_APPROVAL_MODE" "" "$CONF_APPROVAL_MODE" "auto")
            [[ "$approval_mode" == "auto" || "$approval_mode" == "manual" ]] || die "--approval-mode/CONF_APPROVAL_MODE must be auto or manual (got: $approval_mode)"
            CLI_FAMILY="$cli_family"
            APPROVAL_MODE="$approval_mode"

            local num_bees launch_queen queen_only
            num_bees=$(resolve_setting "$CLI_BEES" "" "$CONF_BEES" "3")
            launch_queen=$(resolve_setting "$CLI_QUEEN" "" "$CONF_QUEEN" "true")
            queen_only=$(resolve_setting "$CLI_QUEEN_ONLY" "" "" "false")
            [[ "$queen_only" == "true" || "$queen_only" == "false" ]] || die "--queen-only must resolve to true or false (got: $queen_only)"
            [[ "$launch_queen" == "true" || "$launch_queen" == "false" ]] || die "--no-queen/CONF_QUEEN must resolve to true or false (got: $launch_queen)"
            [[ "$queen_only" == "true" && "$launch_queen" == "false" ]] && die "--queen-only cannot be combined with --no-queen"
            if [[ "$queen_only" != "true" ]]; then
                [[ "$num_bees" =~ ^[2-5]$ ]] || die "--bees must be 2, 3, 4, or 5 (got: $num_bees)"
            fi
            local queen_panes=0
            [[ "$launch_queen" == "true" ]] && queen_panes=1
            local total_agents=$((num_bees + queen_panes))

            if [[ "$mode" == "workspace" ]]; then
                info "Mode: Workspace"
            else
                info "Mode: Single repo"
            fi
            info "Path: $path"
            info "CLI: $cli_family"
            info "Approval mode: $approval_mode"
            [[ "$cli_family" == "cursor" && "$approval_mode" == "auto" ]] && warn "Cursor has no verified Beehive auto-approval profile; native Cursor permissions remain in effect"
            [[ -n "$CLI_CMD_OVERRIDE" ]] && info "CLI command: $CLI_CMD_OVERRIDE"
            if [[ "$queen_only" == "true" ]]; then
                info "Agents: Queen only (no tmux)"
            elif [[ "$launch_queen" == "true" ]]; then
                [[ "$num_bees" -ne 3 ]] && info "Agents: $num_bees bees + Queen ($total_agents total)"
            else
                info "Agents: $num_bees bees, no Queen ($total_agents total)"
            fi
            if [[ "$bee_model" != "$queen_model" ]] && [[ -n "$bee_model" || -n "$queen_model" ]]; then
                [[ -n "$bee_model" ]] && info "Bee model: $bee_model"
                [[ -n "$queen_model" ]] && info "Queen model: $queen_model"
            elif [[ -n "$bee_model" ]]; then
                info "Model: $bee_model"
            fi
            if [[ -n "$ANTHROPIC_BASE_URL" ]]; then
                info "Backend: API proxy ($ANTHROPIC_BASE_URL)"
            elif [[ -n "$AWS_PROFILE" ]]; then
                info "Backend: Bedrock (profile: $AWS_PROFILE, region: ${AWS_REGION:-us-east-1})"
            fi
            echo ""

            if ! $skip_confirm; then
                if [[ "$queen_only" == "true" ]]; then
                    read -p "Launch Queen only without tmux? [Y/n] " -n 1 -r
                elif [[ "$launch_queen" == "true" ]]; then
                    read -p "Launch $total_agents agents ($num_bees bees + Queen)? [Y/n] " -n 1 -r
                else
                    read -p "Launch $total_agents agents ($num_bees bees, no Queen)? [Y/n] " -n 1 -r
                fi
                echo ""
                [[ $REPLY =~ ^[Nn]$ ]] && { echo "Aborted."; exit 0; }
            fi

            if [[ "$queen_only" == "true" ]]; then
                do_queen_only "$path" "$queen_model" "$cli_family"
            else
                do_launch "$path" "$bee_model" "$queen_model" "$num_bees" "$launch_queen" "$cli_family"
            fi
            ;;
    esac
}

if [[ "${BEEHIVE_SOURCE_ONLY:-false}" != "true" ]]; then
    main "$@"
fi
