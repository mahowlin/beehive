#!/bin/bash
# beehive - Multi-agent orchestration for CLI-backed coding agents
#
# Usage:
#   beehive [path]           Run agents (auto-detects mode)
#   beehive --init [path]    Initialize repo/workspace structure
#   beehive --upgrade [path] Upgrade skills, commands, and template
#   beehive --status [path]  Show work items, agent states, and inbox
#   beehive --validate [path] Validate beads health and sessions metadata
#
# The tool auto-detects:
#   - Workspace mode: if path contains multiple git repos
#   - Single repo mode: if path is a single repository
#
# This uses an interactive model where the user directs agents and copies
# messages between them (not autonomous).

set -e

VERSION="0.5.2"

# Resolve symlinks to find actual script location (portable for Linux/macOS)
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
    SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
    SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
    [[ "$SCRIPT_SOURCE" != /* ]] && SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# DEFAULT_SESSION is set dynamically from folder name
CONFIG_FILE=".beehive.conf"

#######################################
# Helpers
#######################################
die() { echo -e "${RED}ERROR: $1${NC}" >&2; exit 1; }
warn() { echo -e "${YELLOW}WARNING: $1${NC}" >&2; }
info() { echo -e "${CYAN}$1${NC}"; }
success() { echo -e "${GREEN}$1${NC}"; }
require_jq() { command -v jq &>/dev/null || die "jq required. Install: brew install jq / apt install jq"; }
require_bd() {
    command -v bd &>/dev/null || die "bd (beads) required. Install: brew install steveyegge/tap/beads"
    local bd_ver
    bd_ver=$(bd version 2>/dev/null | awk '{print $3}')
    if [[ -z "$bd_ver" ]]; then
        die "Could not determine bd version. Run: bd version"
    fi
    # Compare version: require >= 0.61.0
    local IFS='.'
    local -a got=($bd_ver) want=(0 61 0)
    for i in 0 1 2; do
        local g="${got[$i]:-0}" w="${want[$i]:-0}"
        if (( g > w )); then return 0; fi
        if (( g < w )); then
            die "bd (beads) v0.61.0+ required (got v$bd_ver). Update: brew upgrade beads"
        fi
    done
}

#######################################
# Parse config file safely (no source)
#######################################
load_config() {
    local config_path="$1/$CONFIG_FILE"
    [[ ! -f "$config_path" ]] && return 1

    info "Loading config from $config_path"
    while IFS='=' read -r key value; do
        # Skip comments and empty lines
        [[ "$key" =~ ^[[:space:]]*# ]] && continue
        [[ -z "$key" ]] && continue

        # Remove leading/trailing whitespace and quotes
        key=$(echo "$key" | xargs)
        value=$(echo "$value" | xargs | sed 's/^["'"'"']//;s/["'"'"']$//')

        # Only allow known config keys (store as CONF_* to avoid clobbering CLI args)
        case "$key" in
            CONF_AWS_PROFILE)         CONF_AWS_PROFILE="$value" ;;
            CONF_AWS_REGION)          CONF_AWS_REGION="$value" ;;
            CONF_MODEL)               CONF_MODEL="$value" ;;
            CONF_MODEL_BEE)           CONF_MODEL_BEE="$value" ;;
            CONF_MODEL_QUEEN)         CONF_MODEL_QUEEN="$value" ;;
            CONF_SESSION)             CONF_SESSION="$value" ;;
            CONF_CLAUDE_CMD)          CONF_CLAUDE_CMD="$value" ;;
            CONF_CLI)                 CONF_CLI="$value" ;;
            CONF_CLI_CMD)             CONF_CLI_CMD="$value" ;;
            CONF_APPROVAL_MODE)       CONF_APPROVAL_MODE="$value" ;;
            CONF_ANTHROPIC_BASE_URL)  CONF_ANTHROPIC_BASE_URL="$value" ;;
            CONF_ANTHROPIC_API_KEY)   CONF_ANTHROPIC_API_KEY="$value" ;;
            CONF_BEES)                CONF_BEES="$value" ;;
            CONF_QUEEN)               CONF_QUEEN="$value" ;;
            CONF_AGENT_CMD)           CONF_CLI_CMD="$value" ;;
            CONF_MODELS)              CONF_MODELS="$value" ;;
            CONF_MODELS_CMD)          CONF_MODELS_CMD="$value" ;;
            CONF_USAGE_CMD)           CONF_USAGE_CMD="$value" ;;
            CONF_CLI_BEE)             CONF_CLI_BEE="$value" ;;
            CONF_CLI_QUEEN)           CONF_CLI_QUEEN="$value" ;;
            *)
                # Per-Bee and per-CLI keys, e.g. CONF_CLI_BEE_2, CONF_MODEL_BEE_2, CONF_USAGE_CMD_CODEX
                if [[ "$key" =~ ^CONF_(CLI|MODEL)_BEE_[1-5]$ ]] \
                    || [[ "$key" =~ ^CONF_(CLI_CMD|MODELS|MODELS_CMD|USAGE_CMD)_(CLAUDE|CODEX|CURSOR|COPILOT|AGY|VIBE)$ ]]; then
                    printf -v "$key" '%s' "$value"
                fi
                ;;
        esac
    done < "$config_path"
    return 0
}

#######################################
# Detect clipboard for current OS
#######################################
detect_clipboard() {
    if command -v pbcopy &> /dev/null; then
        echo "pbcopy"
    elif command -v xclip &> /dev/null; then
        echo "xclip -selection clipboard"
    elif command -v xsel &> /dev/null; then
        echo "xsel --clipboard --input"
    else
        echo "cat > /dev/null"
    fi
}

#######################################
# Resolve agent CLI command
#######################################
resolve_cli_command() {
    local cli_family="$1" explicit_cmd="$2"

    if [[ -n "$explicit_cmd" ]]; then
        command -v "$explicit_cmd" &> /dev/null && echo "$explicit_cmd" && return 0
        return 1
    fi

    case "$cli_family" in
        claude)
            [[ -n "${CONF_CLAUDE_CMD:-}" ]] && command -v "$CONF_CLAUDE_CMD" &> /dev/null && echo "$CONF_CLAUDE_CMD" && return 0
            for loc in claude /opt/homebrew/bin/claude /usr/local/bin/claude "$HOME/.local/bin/claude"; do
                command -v "$loc" &> /dev/null && echo "$loc" && return 0
            done
            ;;
        codex)
            command -v codex &> /dev/null && echo "codex" && return 0
            ;;
        cursor)
            command -v agent &> /dev/null && echo "agent" && return 0
            ;;
        copilot|agy|vibe)
            command -v "$cli_family" &> /dev/null && echo "$cli_family" && return 0
            ;;
    esac
    return 1
}

SUPPORTED_CLIS="claude codex cursor copilot agy vibe"

is_supported_cli() {
    case "$1" in
        claude|codex|cursor|copilot|agy|vibe) return 0 ;;
    esac
    return 1
}

# CLI name as used in per-CLI config keys, e.g. codex -> CODEX (CONF_CLI_CMD_CODEX).
cli_conf_suffix() {
    printf '%s' "$1" | tr '[:lower:]' '[:upper:]'
}

# Command for one CLI family: --cli-cmd/CONF_CLI_CMD apply to the hive's default CLI,
# CONF_CLI_CMD_<CLI> to that CLI; otherwise the CLI's standard executable.
resolve_agent_cmd() {
    local cli_family="$1" var
    var="CONF_CLI_CMD_$(cli_conf_suffix "$cli_family")"
    if [[ "$cli_family" == "${DEFAULT_CLI:-}" && -n "${CLI_CMD_OVERRIDE:-}" ]]; then
        resolve_cli_command "$cli_family" "$CLI_CMD_OVERRIDE"
    elif [[ -n "${!var:-}" ]]; then
        resolve_cli_command "$cli_family" "${!var}"
    else
        resolve_cli_command "$cli_family" ""
    fi
}

#######################################
# Resolve setting with 4-tier precedence:
#   role CLI → global CLI → role config → global config
#######################################
resolve_setting() {
    local cli_value="$1" cli_fallback="$2" config_value="$3" config_fallback="$4"
    if [[ -n "$cli_value" ]]; then echo "$cli_value"
    elif [[ -n "$cli_fallback" ]]; then echo "$cli_fallback"
    elif [[ -n "$config_value" ]]; then echo "$config_value"
    elif [[ -n "$config_fallback" ]]; then echo "$config_fallback"
    fi
}

#######################################
# Resolve fixed, safe approval arguments for each CLI.
# Never accept arbitrary approval flags from configuration.
#######################################
resolve_approval_args() {
    local cli_family="$1" approval_mode="$2"

    [[ "$approval_mode" == "manual" ]] && return 0
    [[ "$approval_mode" == "auto" ]] || die "Approval mode must be auto or manual (got: $approval_mode)"

    case "$cli_family" in
        claude)
            printf '%q %q' "--permission-mode" "auto"
            ;;
        codex)
            printf '%q %q %q %q %q %q' \
                "--sandbox" "workspace-write" \
                "--ask-for-approval" "on-request" \
                "-c" "approvals_reviewer=auto_review"
            ;;
        cursor)
            # Cursor has no verified equivalent; preserve its native defaults.
            return 0
            ;;
        copilot)
            # Auto-approve file edits only; shell and other tools still prompt.
            printf '%q %q' "--allow-tool" "write"
            ;;
        agy)
            # Auto-accept edits; commands still require approval.
            printf '%q %q' "--mode" "accept-edits"
            ;;
        vibe)
            # Auto-accept edits; other tool calls still require approval.
            printf '%q %q' "--agent" "accept-edits"
            ;;
        *)
            die "Unsupported CLI family for approval mode: $cli_family"
            ;;
    esac
}

#######################################
# Resolve model arguments for CLIs that take the model as a flag.
# Claude (ANTHROPIC_MODEL) and Vibe (VIBE_ACTIVE_MODEL) read it from the environment.
#######################################
resolve_model_args() {
    local cli_family="$1" model="$2"
    [[ -z "$model" ]] && return 0
    case "$cli_family" in
        codex|cursor|copilot|agy) printf '%q %q' "--model" "$model" ;;
    esac
}

#######################################
# Resolve how the startup prompt is passed while keeping the session interactive.
#######################################
resolve_prompt_args() {
    local cli_family="$1" prompt="$2"
    case "$cli_family" in
        copilot|agy) printf '%q %q' "-i" "$prompt" ;;
        *)           printf '%q' "$prompt" ;;
    esac
}

#######################################
# Build per-pane shell command with env vars and model
# Uses inline env prefix (VAR=val cmd) so vars are scoped to the command
#######################################
build_pane_command() {
    local prompt="$1" model="$2" actor="${3:-}"
    local env_prefix="env -u CLAUDECODE COLORTERM=truecolor CLICOLOR=1 CLICOLOR_FORCE=1 FORCE_COLOR=1"
    [[ -n "$AWS_PROFILE" ]] && env_prefix+=" AWS_PROFILE=$(printf '%q' "$AWS_PROFILE")"
    [[ -n "$AWS_REGION" ]] && env_prefix+=" AWS_REGION=$(printf '%q' "$AWS_REGION")"
    [[ -n "$ANTHROPIC_BASE_URL" ]] && env_prefix+=" ANTHROPIC_BASE_URL=$(printf '%q' "$ANTHROPIC_BASE_URL")"
    [[ -n "$ANTHROPIC_API_KEY" ]] && env_prefix+=" ANTHROPIC_API_KEY=$(printf '%q' "$ANTHROPIC_API_KEY")"
    local cli_family="${CLI_FAMILY:-claude}"
    if [[ -n "$model" ]]; then
        case "$cli_family" in
            claude) env_prefix+=" ANTHROPIC_MODEL=$(printf '%q' "$model")" ;;
            vibe)   env_prefix+=" VIBE_ACTIVE_MODEL=$(printf '%q' "$model")" ;;
            *)      ;;  # passed as --model flag

        esac
    fi
    [[ -n "$actor" ]] && env_prefix+=" BD_ACTOR=$(printf '%q' "$actor")"
    local cmd approval_args model_args
    cmd="$env_prefix $(printf '%q' "$AGENT_CMD")"
    approval_args=$(resolve_approval_args "$cli_family" "${APPROVAL_MODE:-auto}")
    model_args=$(resolve_model_args "$cli_family" "$model")
    [[ -n "$approval_args" ]] && cmd+=" $approval_args"
    [[ -n "$model_args" ]] && cmd+=" $model_args"
    printf '%s %s' "$cmd" "$(resolve_prompt_args "$cli_family" "$prompt")"
}

#######################################
# Detect if path is workspace or repo
#######################################
detect_mode() {
    local path="$1"

    # Count git repos in directory
    local git_count=0
    for dir in "$path"/*/; do
        [[ -d "$dir/.git" ]] && git_count=$((git_count + 1))
    done

    # Multiple git repos = workspace, otherwise single repo
    [[ $git_count -gt 1 ]] && echo "workspace" || echo "repo"
}

#######################################
# Initialize structure
#######################################
do_init() {
    local path="$1"
    local mode
    mode=$(detect_mode "$path")

    echo ""
    if [[ "$mode" == "workspace" ]]; then
        info "Initializing workspace in: $path"
        init_workspace "$path"
    else
        info "Initializing repository in: $path"
        init_repo "$path"
    fi
}

init_skills() {
    local dir="$1"
    mkdir -p "$dir/.skills"

    [[ -f "$dir/.skills/bee.md" ]] || cp "$SCRIPT_DIR/skills/bee.md" "$dir/.skills/bee.md"
    [[ -f "$dir/.skills/queen.md" ]] || cp "$SCRIPT_DIR/skills/queen.md" "$dir/.skills/queen.md"
}

init_beads_metadata() {
    local dir="$1"
    local meta="$dir/plans/_meta"
    mkdir -p "$meta"

    # Sessions file is beehive-specific (not in beads)
    [[ -f "$meta/sessions.jsonl" ]] || touch "$meta/sessions.jsonl"

    # Initialize beads if not already present
    if [[ ! -d "$dir/.beads" ]]; then
        info "Initializing beads issue tracker..."
        (cd "$dir" && bd init --quiet) || die "bd init failed"
    fi
}

init_commands() {
    local dir="$1"
    mkdir -p "$dir/.claude/commands"

    for cmd in report buzz bedtime session-report deep-plan review board health; do
        [[ -f "$dir/.claude/commands/$cmd.md" ]] || cp "$SCRIPT_DIR/commands/$cmd.md" "$dir/.claude/commands/$cmd.md"
    done
}

init_gitignore() {
    local dir="$1"
    local gitignore="$dir/.gitignore"

    # If .gitignore doesn't exist, create from template
    if [[ ! -f "$gitignore" ]]; then
        cp "$SCRIPT_DIR/templates/gitignore" "$gitignore"
        return
    fi

    # Ensure .beads/ is in .gitignore
    if ! grep -q '\.beads/' "$gitignore" 2>/dev/null; then
        echo "" >> "$gitignore"
        echo "# Beads issue tracker (local database)" >> "$gitignore"
        echo ".beads/" >> "$gitignore"
    fi

    # Remove stale entries from old versions
    if grep -q '^\.hive/' "$gitignore" 2>/dev/null; then
        sed -i.bak '/^\.hive\//d' "$gitignore" && rm -f "$gitignore.bak"
    fi
    if grep -q 'plans/_meta/' "$gitignore" 2>/dev/null; then
        awk '
            $0 ~ /^plans\/\_meta\/claims\/$/ { next }
            { print }
        ' "$gitignore" > "$gitignore.tmp" && mv "$gitignore.tmp" "$gitignore"
    fi
}

init_template() {
    local dir="$1"

    [[ -f "$dir/plans/TEMPLATE.md" ]] || cp "$SCRIPT_DIR/templates/plan.md" "$dir/plans/TEMPLATE.md"
}

init_repo() {
    local dir="$1"
    mkdir -p "$dir/plans/completed"
    mkdir -p "$dir/plans/_meta"

    [[ ! -f "$dir/CLAUDE.md" ]] && cat > "$dir/CLAUDE.md" << 'EOF'
# Project Instructions for Claude

## Overview
<!-- Describe the project -->

## Agent Roles
- **Queen**: Owns super-swarms, critical path, Bee slot state, dispatch, and verification. Read `.skills/queen.md`
- **Bees**: Own scoped swarms and execute assigned beads. Read `.skills/bee.md`

## Coordination
This project uses **beads** (`bd`) for task tracking and coordination.
- Assigned executable beads are the plan; do not enter Claude plan mode for scoped work
- Queen reviews `bd ready`; Bees do not self-dispatch unless explicitly authorized
- `bd update <id> --claim` — claim only when Queen/free-pick allows it
- `bd close <id>` — mark complete with evidence
- `bd create` — create parented or source-linked issues/tasks
- `plans/` — archive only; new plans are Beads epics
- `plans/_meta/sessions.jsonl` — session metadata (Queen owns)

## Guidelines
- Ask approval before environment-impacting operations
- Bees report completion to Queen for verification
- Use /buzz, /report, /bedtime, /session-report, /deep-plan commands
EOF

    init_beads_metadata "$dir"
    init_skills "$dir"
    init_commands "$dir"
    init_template "$dir"
    init_gitignore "$dir"

    success "✓ Initialized: $dir"
    echo "  Run: beehive $dir"
}

init_workspace() {
    local dir="$1"
    mkdir -p "$dir/plans/completed"
    mkdir -p "$dir/plans/_meta"

    [[ ! -f "$dir/CLAUDE.md" ]] && {
        {
            echo "# Workspace Instructions"
            echo ""
            echo "Multi-repo workspace. All coordination via Beads."
            echo "When assigned a bead, cd to the target repo and read its CLAUDE.md."
            echo ""
            echo "## Repositories"
            echo "| Repository | Description |"
            echo "|------------|-------------|"
            for repo in "$dir"/*/; do
                [[ -d "$repo/.git" ]] && echo "| \`$(basename "$repo")/\` | <!-- describe --> |"
            done
            echo ""
            echo "## Agent Roles"
            echo "- **Queen**: Owns super-swarms, critical path, Bee slot state, dispatch, and verification. Read \`.skills/queen.md\`"
            echo "- **Bees**: Own scoped swarms and execute assigned beads. Read \`.skills/bee.md\`"
            echo ""
            echo "## Coordination"
            echo "This project uses **beads** (\`bd\`) for task tracking and coordination."
            echo "- Assigned executable beads are the plan; do not enter Claude plan mode for scoped work"
            echo "- Queen reviews \`bd ready\`; Bees do not self-dispatch unless explicitly authorized"
            echo "- \`bd update <id> --claim\` — claim only when Queen/free-pick allows it"
            echo "- \`bd close <id>\` — mark complete with evidence"
            echo "- \`bd create\` — create parented or source-linked issues/tasks"
            echo "- \`plans/\` — archive only; new plans are Beads epics"
            echo "- \`plans/_meta/sessions.jsonl\` — session metadata (Queen owns)"
            echo ""
            echo "## Guidelines"
            echo "- Ask approval before environment-impacting operations"
            echo "- Bees report completion to Queen for verification"
            echo "- Use /buzz, /report, /bedtime, /session-report, /deep-plan commands"
        } > "$dir/CLAUDE.md"
    }

    # Add CLAUDE.md to repos that don't have one
    for repo in "$dir"/*/; do
        [[ -d "$repo/.git" && ! -f "$repo/CLAUDE.md" ]] && {
            {
                echo "# $(basename "$repo")"
                echo ""
                echo "## Overview"
                echo "<!-- Describe this repo -->"
            } > "$repo/CLAUDE.md"
        }
    done

    init_beads_metadata "$dir"
    init_skills "$dir"
    init_commands "$dir"
    init_template "$dir"
    init_gitignore "$dir"

    success "✓ Initialized workspace: $dir"
    echo "  Run: beehive $dir"
}

bee_prompt_text() {
    local bee_num="$1" path="$2"
    printf "Read CLAUDE.md and .skills/bee.md. You are Bee %d. Run 'bd -C %q prime'. Then run 'bd -C %q list --assignee bee-%d'. If assigned work exists, show the current executable bead and execute it; the bead is the plan. Do not self-dispatch from bd ready, create plans, or mutate live systems without an accepted intention gate. If no assignment or scope is unclear, report idle/blocked or PRE-WORK to Queen. If this CLI rejects slash commands, treat buzz/report/bedtime as named procedures from .skills/.claude/commands and perform the equivalent bd comments/updates directly." "$bee_num" "$path" "$path" "$bee_num"
}

queen_prompt_text() {
    local path="$1"
    printf "Read CLAUDE.md and .skills/queen.md. You are the Queen. Run 'bd -C %q prime' for workflow context. Follow your skill instructions. You own super-swarms, critical path, Bee slot state, and dispatch; Bees own scoped swarms. Use buzz for tactical dispatch refresh and session-report for maturity/unlocks/roadblocks. If this CLI rejects slash commands, treat buzz/board/health/report/bedtime/session-report/deep-plan/review as named procedures from .skills/.claude/commands and perform the equivalent bd comments/updates directly. For model selection run '%q --models --json' (models, per-Bee model, usage) and, after user approval, '%q --switch-model bee-N MODEL'. Wait for user direction." "$path" "$BEEHIVE_BIN" "$BEEHIVE_BIN"
}

#######################################
# Launch agents
#######################################
do_queen_only() {
    local path="$1" queen_model="$2" cli_family="${3:-claude}"

    DEFAULT_CLI="${DEFAULT_CLI:-$cli_family}"
    CLI_FAMILY="${QUEEN_CLI:-$cli_family}"
    AGENT_CMD=$(resolve_agent_cmd "$CLI_FAMILY") || die "Agent CLI '$CLI_FAMILY' not found. Install it or set CONF_CLI_CMD/--cli-cmd."

    if [[ -n "$ANTHROPIC_BASE_URL" ]]; then
        if ! curl -sf --max-time 5 "${ANTHROPIC_BASE_URL}/health" > /dev/null 2>&1; then
            die "Cannot reach API proxy at $ANTHROPIC_BASE_URL/health — is it running?"
        fi
    fi

    [[ ! -f "$path/CLAUDE.md" ]] && die "Not initialized. Run: beehive --init $path"

    if (cd "$path" && bd context >/dev/null) 2>/dev/null; then
        success "  Beads context ready"
    else
        warn "Could not validate Beads context (Queen will report details from bd prime)"
    fi

    local prompt queen_cmd
    prompt=$(queen_prompt_text "$path")
    queen_cmd=$(build_pane_command "$prompt" "$queen_model" "queen")

    success "✓ Launching Queen only (no tmux)"
    cd "$path" || die "Could not cd to $path"
    eval "$queen_cmd"
}

do_launch() {
    local path="$1" bee_model="$2" queen_model="$3" num_bees="${4:-3}" launch_queen="${5:-true}" cli_family="${6:-claude}"
    local queen_panes=0
    [[ "$launch_queen" == "true" ]] && queen_panes=1
    local total_panes=$((num_bees + queen_panes))
    local mode
    mode=$(detect_mode "$path")

    # Config already loaded before confirmation

    # Resolve the CLI of every agent up front (Bees and Queen may use different CLIs)
    DEFAULT_CLI="${DEFAULT_CLI:-$cli_family}"
    local queen_cli="${QUEEN_CLI:-$cli_family}"
    local -a agent_clis=() agent_cmds=() agent_models=()
    local n fam
    for (( n=1; n<=num_bees; n++ )); do
        fam="${BEE_CLIS[$n]:-$cli_family}"
        agent_clis[n]="$fam"
        agent_models[n]="${BEE_MODELS[$n]-$bee_model}"
        agent_cmds[n]=$(resolve_agent_cmd "$fam") || die "Agent CLI '$fam' (bee-$n) not found. Install it or set CONF_CLI_CMD_$(cli_conf_suffix "$fam")."
    done
    local queen_cmd_path=""
    if [[ "$launch_queen" == "true" ]]; then
        queen_cmd_path=$(resolve_agent_cmd "$queen_cli") || die "Agent CLI '$queen_cli' (queen) not found. Install it or set CONF_CLI_CMD_$(cli_conf_suffix "$queen_cli")."
    fi
    local default_cmd
    default_cmd=$(resolve_agent_cmd "$cli_family" || true)

    # Check requirements
    command -v tmux &> /dev/null || die "tmux required. Install: brew install tmux"

    # Health check for custom API endpoint
    if [[ -n "$ANTHROPIC_BASE_URL" ]]; then
        if ! curl -sf --max-time 5 "${ANTHROPIC_BASE_URL}/health" > /dev/null 2>&1; then
            die "Cannot reach API proxy at $ANTHROPIC_BASE_URL/health — is it running?"
        fi
    fi

    [[ ! -f "$path/CLAUDE.md" ]] && die "Not initialized. Run: beehive --init $path"

    # Beads 1.0+ uses embedded Dolt by default; do not start a persistent server.
    if (cd "$path" && bd context >/dev/null) 2>/dev/null; then
        success "  Beads context ready"
    else
        warn "Could not validate Beads context (agents will report details from bd prime)"
    fi

    # Kill existing
    tmux kill-session -t "$SESSION_NAME" 2>/dev/null || true

    # Create session
    local clip
    clip=$(detect_clipboard)

    tmux new-session -d -s "$SESSION_NAME" -c "$path" -x 200 -y 50
    # Create remaining panes (session creation gives us pane 0)
    for (( i=1; i<total_panes; i++ )); do
        tmux split-window -t "$SESSION_NAME:0" -c "$path"
    done
    if [[ "$total_panes" -eq 2 ]]; then
        tmux select-layout -t "$SESSION_NAME" even-horizontal
    else
        tmux select-layout -t "$SESSION_NAME" tiled
    fi

    # Make tmux preserve rich CLI UIs (Codex/Cursor/Claude) instead of falling back
    # to a stripped-down terminal style.
    tmux set-option -t "$SESSION_NAME" -g default-terminal "tmux-256color"
    tmux set-option -t "$SESSION_NAME" -ga terminal-overrides ",*:Tc"
    tmux set-option -t "$SESSION_NAME" -g focus-events on
    tmux set-option -t "$SESSION_NAME" -g aggressive-resize on
    tmux set-option -t "$SESSION_NAME" -g status on
    tmux set-option -t "$SESSION_NAME" -g status-position bottom
    tmux set-option -t "$SESSION_NAME" -g status-style "bg=colour234,fg=colour250"
    tmux set-option -t "$SESSION_NAME" -g status-left-style "fg=colour220,bold"
    tmux set-option -t "$SESSION_NAME" -g status-left-length 40
    tmux set-option -t "$SESSION_NAME" -g status-left " 🐝 #S "
    tmux set-option -t "$SESSION_NAME" -g status-right-style "fg=colour245"
    tmux set-option -t "$SESSION_NAME" -g status-right " %H:%M "
    tmux set-window-option -t "$SESSION_NAME" -g window-status-current-style "bg=colour238,fg=colour220,bold"
    tmux set-window-option -t "$SESSION_NAME" -g mode-style "bg=colour238,fg=colour220,bold"
    tmux set-option -t "$SESSION_NAME" pane-border-status top
    tmux set-option -t "$SESSION_NAME" pane-border-format " #[fg=colour245]#[fg=colour234,bg=colour245,bold] #T #[fg=colour245,bg=default] "
    tmux set-option -t "$SESSION_NAME" -g pane-border-style "fg=colour238"
    tmux set-option -t "$SESSION_NAME" -g pane-active-border-style "fg=colour220,bold"
    tmux set-option -t "$SESSION_NAME" mouse on
    tmux set-option -t "$SESSION_NAME" -g set-clipboard on
    tmux bind-key -T copy-mode MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "$clip"
    tmux bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "$clip"

    # Hive metadata for --models / --switch-model (no secrets stored)
    tmux set-option -t "$SESSION_NAME" @beehive_cli "$cli_family"
    tmux set-option -t "$SESSION_NAME" @beehive_cli_cmd "$default_cmd"
    tmux set-option -t "$SESSION_NAME" @beehive_approval "${APPROVAL_MODE:-auto}"
    tmux set-option -t "$SESSION_NAME" @beehive_path "$path"
    tmux set-option -t "$SESSION_NAME" @beehive_aws_profile "$AWS_PROFILE"
    tmux set-option -t "$SESSION_NAME" @beehive_aws_region "$AWS_REGION"
    tmux set-option -t "$SESSION_NAME" @beehive_base_url "$ANTHROPIC_BASE_URL"

    # Name panes: bees 0..num_bees-1, optional queen at num_bees
    for (( i=0; i<num_bees; i++ )); do
        local bee_num=$((i + 1))
        tmux select-pane -t "$SESSION_NAME:0.$i" -T "🐝 Bee $bee_num"
    done
    if [[ "$launch_queen" == "true" ]]; then
        tmux select-pane -t "$SESSION_NAME:0.$num_bees" -T "🐝 Queen"
    fi

    # Prompts - agents read their skill files and use bd for coordination
    local queen_prompt
    queen_prompt=$(queen_prompt_text "$path")

    # Launch bees with bee_model and BD_ACTOR identity
    for (( i=0; i<num_bees; i++ )); do
        local prompt
        local bee_num=$((i + 1))
        prompt=$(bee_prompt_text "$bee_num" "$path")
        local pane_cmd
        CLI_FAMILY="${agent_clis[$bee_num]}"
        AGENT_CMD="${agent_cmds[$bee_num]}"
        pane_cmd=$(build_pane_command "$prompt" "${agent_models[$bee_num]}" "bee-$bee_num")
        tmux set-option -p -t "$SESSION_NAME:0.$i" @beehive_actor "bee-$bee_num"
        tmux set-option -p -t "$SESSION_NAME:0.$i" @beehive_cli "$CLI_FAMILY"
        tmux set-option -p -t "$SESSION_NAME:0.$i" @beehive_cli_cmd "$AGENT_CMD"
        tmux set-option -p -t "$SESSION_NAME:0.$i" @beehive_model "${agent_models[$bee_num]}"
        tmux send-keys -t "$SESSION_NAME:0.$i" "$pane_cmd" Enter
        sleep 1
    done

    # Launch optional queen with queen_model and BD_ACTOR identity
    if [[ "$launch_queen" == "true" ]]; then
        local queen_cmd
        CLI_FAMILY="$queen_cli"
        AGENT_CMD="$queen_cmd_path"
        queen_cmd=$(build_pane_command "$queen_prompt" "$queen_model" "queen")
        tmux set-option -p -t "$SESSION_NAME:0.$num_bees" @beehive_actor "queen"
        tmux set-option -p -t "$SESSION_NAME:0.$num_bees" @beehive_cli "$CLI_FAMILY"
        tmux set-option -p -t "$SESSION_NAME:0.$num_bees" @beehive_cli_cmd "$AGENT_CMD"
        tmux set-option -p -t "$SESSION_NAME:0.$num_bees" @beehive_model "$queen_model"
        tmux send-keys -t "$SESSION_NAME:0.$num_bees" "$queen_cmd" Enter
        tmux select-pane -t "$SESSION_NAME:0.$num_bees"
    else
        tmux select-pane -t "$SESSION_NAME:0.0"
    fi

    echo ""
    if [[ "$launch_queen" == "true" ]]; then
        success "✓ Launched $total_panes agents ($num_bees bees + Queen)"
    else
        success "✓ Launched $total_panes agents ($num_bees bees, no Queen)"
    fi
    echo ""
    if [[ "$num_bees" -eq 2 ]]; then
        if [[ "$launch_queen" == "true" ]]; then
            echo "  ┌──────────┬──────────┐"
            echo "  │ 🐝 Bee 1 │ 🐝 Bee 2 │"
            echo "  ├──────────┴──────────┤"
            echo "  │      🐝 Queen       │"
            echo "  └─────────────────────┘"
        else
            echo "  ┌──────────┬──────────┐"
            echo "  │ 🐝 Bee 1 │ 🐝 Bee 2 │"
            echo "  └──────────┴──────────┘"
        fi
    elif [[ "$num_bees" -eq 3 ]]; then
        if [[ "$launch_queen" == "true" ]]; then
            echo "  ┌──────────┬──────────┐"
            echo "  │ 🐝 Bee 1 │ 🐝 Bee 2 │"
            echo "  ├──────────┼──────────┤"
            echo "  │ 🐝 Bee 3 │ 🐝 Queen │"
            echo "  └──────────┴──────────┘"
        else
            echo "  ┌──────────┬──────────┬──────────┐"
            echo "  │ 🐝 Bee 1 │ 🐝 Bee 2 │ 🐝 Bee 3 │"
            echo "  └──────────┴──────────┴──────────┘"
        fi
    elif [[ "$num_bees" -eq 4 ]]; then
        if [[ "$launch_queen" == "true" ]]; then
            echo "  ┌──────────┬──────────┐"
            echo "  │ 🐝 Bee 1 │ 🐝 Bee 2 │"
            echo "  ├──────────┼──────────┤"
            echo "  │ 🐝 Bee 3 │ 🐝 Bee 4 │"
            echo "  ├──────────┴──────────┤"
            echo "  │      🐝 Queen       │"
            echo "  └─────────────────────┘"
        else
            echo "  ┌──────────┬──────────┐"
            echo "  │ 🐝 Bee 1 │ 🐝 Bee 2 │"
            echo "  ├──────────┼──────────┤"
            echo "  │ 🐝 Bee 3 │ 🐝 Bee 4 │"
            echo "  └──────────┴──────────┘"
        fi
    elif [[ "$num_bees" -eq 5 ]]; then
        if [[ "$launch_queen" == "true" ]]; then
            echo "  ┌──────────┬──────────┬──────────┐"
            echo "  │ 🐝 Bee 1 │ 🐝 Bee 2 │ 🐝 Bee 3 │"
            echo "  ├──────────┼──────────┼──────────┤"
            echo "  │ 🐝 Bee 4 │ 🐝 Bee 5 │ 🐝 Queen │"
            echo "  └──────────┴──────────┴──────────┘"
        else
            echo "  ┌──────────┬──────────┬──────────┐"
            echo "  │ 🐝 Bee 1 │ 🐝 Bee 2 │ 🐝 Bee 3 │"
            echo "  ├──────────┴──────────┼──────────┤"
            echo "  │ 🐝 Bee 4            │ 🐝 Bee 5 │"
