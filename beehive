#######################################
# Upgrade existing project
#######################################
do_upgrade() {
    local path="$1"

    # Must already be initialized
    [[ ! -d "$path/plans" ]] && die "Not initialized. Run: beehive --init $path"

    if $DRY_RUN; then
        echo ""
        echo -e "${GREEN}Beehive Upgrade (dry run)${NC} — $(basename "$path")"
        echo ""
        echo "  Would overwrite:"
        echo "    .skills/bee.md"
        echo "    .skills/queen.md"
        for cmd in report buzz bedtime session-report deep-plan review board health; do
            [[ -f "$SCRIPT_DIR/commands/$cmd.md" ]] && echo "    .claude/commands/$cmd.md"
        done
        echo "    plans/TEMPLATE.md"
        echo ""
        echo "  Would remove (if present):"
        [[ -f "$path/.claude/commands/sting.md" ]] && echo "    .claude/commands/sting.md"
        [[ -f "$path/.claude/commands/refresh.md" ]] && echo "    .claude/commands/refresh.md"
        [[ -f "$path/WORKSPACE.md" ]] && echo "    WORKSPACE.md → plans/_meta/migrated/"
        echo ""
        echo "  Would initialize (if missing):"
        [[ ! -d "$path/.beads" ]] && echo "    .beads/ (beads issue tracker)"
        [[ ! -f "$path/plans/_meta/sessions.jsonl" ]] && echo "    plans/_meta/sessions.jsonl"
        echo ""

        # Check legacy markdown migration (v0.2.x-v0.4.x → beads)
        _migrate_markdown_to_beads "$path"

        [[ -f "$path/0.5.0_PRE_RELEASE_FEEDBACK.md" ]] && echo "  Would remove: 0.5.0_PRE_RELEASE_FEEDBACK.md"
        [[ -f "$path/plans/_review_prompt.md" ]] && echo "  Would remove: plans/_review_prompt.md"


        if [[ -e "$path/templates/schemas.md" ]]; then
            echo "  Would remove: templates/schemas.md"
        fi

        if [[ -f "$path/0.5.0_PRE_RELEASE_FEEDBACK.md" ]]; then
            echo ""
            warn "Release artifact present: 0.5.0_PRE_RELEASE_FEEDBACK.md"
        fi

        echo ""
        info "No changes made (dry run)."
        return
    fi

    info "Upgrading beehive files in: $path"

    # Upgrade skills (overwrite)
    mkdir -p "$path/.skills"
    cp "$SCRIPT_DIR/skills/bee.md" "$path/.skills/bee.md"
    cp "$SCRIPT_DIR/skills/queen.md" "$path/.skills/queen.md"

    # Upgrade commands (overwrite)
    mkdir -p "$path/.claude/commands"
    for cmd in report buzz bedtime session-report deep-plan review board health; do
        [[ -f "$SCRIPT_DIR/commands/$cmd.md" ]] && cp "$SCRIPT_DIR/commands/$cmd.md" "$path/.claude/commands/$cmd.md"
    done

    # Clean up removed commands
    rm -f "$path/.claude/commands/sting.md"
    rm -f "$path/.claude/commands/refresh.md"

    # Clean up removed workspace file (v0.4.0 → v0.5.0)
    if [[ -f "$path/WORKSPACE.md" ]]; then
        mkdir -p "$path/plans/_meta/migrated"
        mv "$path/WORKSPACE.md" "$path/plans/_meta/migrated/"
    fi

    # Upgrade plan template (overwrite)
    cp "$SCRIPT_DIR/templates/plan.md" "$path/plans/TEMPLATE.md"

    # Initialize beads + sessions metadata (idempotent)
    init_beads_metadata "$path"

    # Migrate legacy markdown tracking directly to beads
    _migrate_markdown_to_beads "$path"

    # Clean up removed files/dirs
    rm -f "$path/templates/schemas.md" 2>/dev/null || true
    rm -f "$path/0.5.0_PRE_RELEASE_FEEDBACK.md" 2>/dev/null || true
    rm -f "$path/plans/_review_prompt.md" 2>/dev/null || true


    # Update gitignore
    init_gitignore "$path"

    success "✓ Upgraded to v$VERSION"
    echo "  Skills, commands, and template updated."
    echo "  Beads issue tracker initialized."
    echo ""
    echo "  Review changes:"
    echo "    .skills/bee.md, .skills/queen.md"
    echo "    .claude/commands/*"
    echo "    plans/TEMPLATE.md"
    echo "    .beads/ (issue tracker database)"
}

_migrate_markdown_to_beads() {
    local path="$1"
    local meta="$path/plans/_meta"
    local migrated="$meta/migrated"
    local tracker_file=""

    if [[ -f "$meta/TRACKER.md" ]]; then
        tracker_file="$meta/TRACKER.md"
    elif [[ -f "$path/plans/TRACKER.md" ]]; then
        tracker_file="$path/plans/TRACKER.md"
    elif [[ -f "$path/TRACKER.md" ]]; then
        tracker_file="$path/TRACKER.md"
    fi

    if $DRY_RUN; then
        local would_migrate=false
        [[ -n "$tracker_file" ]] && would_migrate=true
        [[ -d "$path/.hive" ]] && would_migrate=true
        [[ -f "$path/plans/INBOX.md" ]] && would_migrate=true
        [[ -f "$meta/SESSION_LOG.md" ]] && would_migrate=true
        [[ -f "$meta/DEPENDENCIES.md" ]] && would_migrate=true
        $would_migrate || return 0

        echo "  Would migrate:"
        if [[ -n "$tracker_file" ]]; then
            local active_count=0 completed_count=0 section=""
            while IFS= read -r line; do
                [[ "$line" == *"## Active"* ]] && { section="active"; continue; }
                [[ "$line" == *"## Completed"* ]] && { section="completed"; continue; }
                [[ "$line" == "## "* ]] && { section=""; continue; }
                [[ "$line" == "|--"* || "$line" == "| Plan "* || "$line" == "###"* || -z "$line" ]] && continue
                [[ "$line" != \|* ]] && continue
                [[ "$section" == "active" ]] && active_count=$((active_count + 1))
                [[ "$section" == "completed" ]] && completed_count=$((completed_count + 1))
            done < "$tracker_file"
            echo "    TRACKER.md → beads ($active_count active, $completed_count completed)"
            echo "    id-mapping.json → plans/_meta/migrated/"
            echo "    Note: relationships are not imported from TRACKER.md"
        fi
        [[ -d "$path/.hive" ]] && echo "    .hive/ → plans/_meta/migrated/"
        [[ -f "$path/plans/INBOX.md" ]] && echo "    INBOX.md → plans/_meta/migrated/"
        [[ -f "$meta/SESSION_LOG.md" ]] && echo "    SESSION_LOG.md → plans/_meta/migrated/"
        [[ -f "$meta/DEPENDENCIES.md" ]] && echo "    DEPENDENCIES.md → plans/_meta/migrated/"
        return 0
    fi

    local existing_count
    existing_count=$(cd "$path" && bd list --json --all 2>/dev/null | jq 'length' 2>/dev/null || echo "0")
    if [[ "$existing_count" -gt 0 ]]; then
        info "  Beads already has issues; skipping tracker migration"
        return 0
    fi

    local needs_archive=false
    [[ -n "$tracker_file" ]] && needs_archive=true
    [[ -d "$path/.hive" ]] && needs_archive=true
    [[ -f "$path/plans/INBOX.md" ]] && needs_archive=true
    [[ -f "$meta/SESSION_LOG.md" ]] && needs_archive=true
    [[ -f "$meta/DEPENDENCIES.md" ]] && needs_archive=true
    $needs_archive || return 0

    mkdir -p "$migrated"

    local report_lines=()
    _report() { report_lines+=("$1"); }
    _strip_md() { echo "$1" | sed 's/\*\*//g; s/\[\([^]]*\)\]([^)]*)/\1/g'; }
    _parse_tracker_cells() {
        printf '%s\n' "$1" | awk -F'|' '{
            n=0; out=""
            for(i=2; i<NF; i++) {
                gsub(/^[ \t]+|[ \t]+$/, "", $i)
                if(n>0) out=out"\t"
                out=out $i; n++
            }
            if(n>0) print out; else exit 1
        }'
    }

    local tracker_copy=""
    if [[ -n "$tracker_file" ]]; then
        tracker_copy="$migrated/$(basename "$tracker_file")"
        cp "$tracker_file" "$tracker_copy"
        _report "- TRACKER.md found at: \`$tracker_file\`"
    fi
    [[ -d "$path/.hive" && ! -e "$migrated/.hive" ]] && cp -R "$path/.hive" "$migrated/.hive"
    [[ -f "$path/plans/INBOX.md" && ! -e "$migrated/INBOX.md" ]] && cp "$path/plans/INBOX.md" "$migrated/INBOX.md"
    [[ -f "$meta/SESSION_LOG.md" && ! -e "$migrated/SESSION_LOG.md" ]] && cp "$meta/SESSION_LOG.md" "$migrated/SESSION_LOG.md"
    [[ -f "$meta/DEPENDENCIES.md" && ! -e "$migrated/DEPENDENCIES.md" ]] && cp "$meta/DEPENDENCIES.md" "$migrated/DEPENDENCIES.md"

    local migrate_count=0 archive_count=0
    local id_map='{}'

    if [[ -n "$tracker_file" ]]; then
        local section=""
        while IFS= read -r line; do
            [[ "$line" == *"## Active"* ]] && { section="active"; continue; }
            [[ "$line" == *"## Completed"* ]] && { section="completed"; continue; }
            [[ "$line" == "## "* ]] && { section=""; continue; }
            [[ "$line" == "|--"* ]] && continue
            [[ "$line" == "| Plan |"* ]] && continue
            [[ "$line" == "###"* ]] && continue
            [[ -z "$line" ]] && continue
            [[ "$line" != \|* ]] && continue

            if [[ "$section" == "active" ]]; then
                local plan status priority summary cells col_count old_id bd_priority new_id bd_status
                cells=$(_parse_tracker_cells "$line") || {
                    _report "- Skipped unparseable row: $(echo "$line" | head -c 60)..."
                    continue
                }
                col_count=$(printf '%s\n' "$cells" | awk -F'\t' '{print NF}')
                if [[ "$col_count" -lt 4 ]]; then
                    _report "- Skipped unparseable row: $(echo "$line" | head -c 60)..."
                    continue
                fi

                plan=$(_strip_md "$(printf '%s\n' "$cells" | awk -F'\t' '{print $1}')")
                status=$(_strip_md "$(printf '%s\n' "$cells" | awk -F'\t' '{print $2}')")
                priority=$(_strip_md "$(printf '%s\n' "$cells" | awk -F'\t' '{print $3}')")
                summary=$(_strip_md "$(printf '%s\n' "$cells" | awk -F'\t' '{print $4}')")
                [[ -z "$plan" ]] && continue

                status=$(echo "$status" | awk '{print tolower($1)}' | sed 's/^[ 	]*//;s/[ 	]*$//')
                case "$status" in
                    ready|pending) bd_status="open" ;;
                    working|near-complete|in) bd_status="in_progress" ;;
                    blocked|deferred) bd_status="blocked" ;;
                    done|archived|complete|completed|finished) bd_status="closed" ;;
                    *) _report "- \`$plan\`: status \`$status\` unrecognized, defaulted to open"; bd_status="open" ;;
                esac

                case "$(echo "$priority" | tr '[:upper:]' '[:lower:]')" in
                    critical|crit|high|hi) bd_priority=1 ;;
                    medium|med|low|lo) bd_priority=2 ;;
                    reference|ref) bd_priority=3 ;;
                    *) bd_priority=2 ;;
                esac

                old_id="P-$(printf '%03d' $((migrate_count + archive_count + 1)))"
                if [[ -n "$summary" && "$summary" != "-" ]]; then
                    new_id=$(cd "$path" && bd create "$plan" --type epic -p "$bd_priority" --description "$summary" --json | jq -r '.id')
                else
                    new_id=$(cd "$path" && bd create "$plan" --type epic -p "$bd_priority" --description "Migrated from TRACKER.md" --json | jq -r '.id')
                fi

                if [[ "$bd_status" == "closed" ]]; then
                    (cd "$path" && bd close "$new_id" --reason "Migrated as done" --quiet) >/dev/null 2>&1 || true
                elif [[ "$bd_status" == "in_progress" ]]; then
                    (cd "$path" && bd update "$new_id" --status in_progress --quiet) >/dev/null 2>&1 || true
                elif [[ "$bd_status" == "blocked" ]]; then
                    (cd "$path" && bd update "$new_id" --status blocked --quiet) >/dev/null 2>&1 || true
                fi

                id_map=$(echo "$id_map" | jq --arg old "$old_id" --arg new "$new_id" '. + {($old): $new}')
                migrate_count=$((migrate_count + 1))
            elif [[ "$section" == "completed" ]]; then
                local plan summary cells old_id new_id
                local col_count
                cells=$(_parse_tracker_cells "$line") || {
                    _report "- Skipped unparseable row: $(echo "$line" | head -c 60)..."
                    continue
                }
                col_count=$(printf '%s\n' "$cells" | awk -F'\t' '{print NF}')
                if [[ "$col_count" -lt 2 ]]; then
                    _report "- Skipped unparseable row: $(echo "$line" | head -c 60)..."
                    continue
                fi

                plan=$(_strip_md "$(printf '%s\n' "$cells" | awk -F'\t' '{print $1}')")
                summary=$(_strip_md "$(printf '%s\n' "$cells" | awk -F'\t' '{print $2}')")
                [[ -z "$plan" ]] && continue

                old_id="P-$(printf '%03d' $((migrate_count + archive_count + 1)))"
                if [[ -n "$summary" && "$summary" != "-" ]]; then
                    new_id=$(cd "$path" && bd create "$plan" --type epic -p 3 --description "$summary" --json | jq -r '.id')
                else
                    new_id=$(cd "$path" && bd create "$plan" --type epic -p 3 --description "Migrated from archive" --json | jq -r '.id')
                fi
                (cd "$path" && bd close "$new_id" --reason "Archived (migrated)" --quiet) >/dev/null 2>&1 || true
                id_map=$(echo "$id_map" | jq --arg old "$old_id" --arg new "$new_id" '. + {($old): $new}')
                archive_count=$((archive_count + 1))
            fi
        done < "$tracker_file"

        mv "$tracker_file" "$migrated/"
    fi

    if [[ -d "$path/.hive" ]]; then
        rm -rf "$migrated/.hive" 2>/dev/null || true
        mv "$path/.hive" "$migrated/"
    fi
    [[ -f "$path/plans/INBOX.md" ]] && mv "$path/plans/INBOX.md" "$migrated/"
    [[ -f "$meta/SESSION_LOG.md" ]] && mv "$meta/SESSION_LOG.md" "$migrated/"
    [[ -f "$meta/DEPENDENCIES.md" ]] && mv "$meta/DEPENDENCIES.md" "$migrated/"

    echo "$id_map" | jq '.' > "$migrated/id-mapping.json"

    {
        echo "# Migration Report"
        echo ""
        echo "**Date:** $(date +%Y-%m-%d)"
        echo "**Beehive version:** v$VERSION"
        echo "**Source:** markdown tracker files"
        echo "**Target:** beads issues"
        echo ""
        echo "## Summary"
        echo ""
        echo "- Active work items migrated to beads: $migrate_count"
        echo "- Completed items migrated to beads: $archive_count"
        echo "- Original files preserved in: \`plans/_meta/migrated/\`"
        echo "- relationships not imported from TRACKER.md"
        echo ""
        if [[ ${#report_lines[@]} -gt 0 ]]; then
            echo "## Fallbacks and Warnings"
            echo ""
            for line in "${report_lines[@]}"; do
                echo "$line"
            done
            echo ""
        fi
        echo "## Originals"
        echo ""
        for f in "$migrated"/*; do
            [[ -e "$f" ]] && echo "- \`$(basename "$f")\`"
        done
    } > "$migrated/migration-report.md"

    success "  Migrated legacy tracking files to beads"
    info "  ID mapping: plans/_meta/migrated/id-mapping.json"
    info "  Migration report: plans/_meta/migrated/migration-report.md"
}

#######################################
# Models & usage (dynamic Queen model selection)
#######################################
MODEL_NAME_RE='^[A-Za-z0-9][A-Za-z0-9._:/@+-]*(\[[A-Za-z0-9]+\])?$'
BEEHIVE_BIN="$SCRIPT_DIR/$(basename "$SCRIPT_SOURCE")"

valid_model_name() {
    [[ "$1" =~ $MODEL_NAME_RE ]]
}

run_with_timeout() {
    local secs="$1"; shift
    if command -v timeout &> /dev/null; then
        timeout "$secs" "$@"
    else
        "$@"
    fi
}

# Run a command configured in .beehive.conf without a shell (no pipes, no substitution).
run_config_command() {
    local -a argv
    read -ra argv <<< "$1"
    [[ ${#argv[@]} -gt 0 ]] || return 1
    run_with_timeout 20 "${argv[@]}" < /dev/null 2> /dev/null
}

# Keep only the first field of lines that look like model identifiers.
# Requires a digit or separator so headers like "Available" are dropped.
filter_model_names() {
    local line name
    while IFS= read -r line; do
        name=$(printf '%s' "$line" | sed -E 's/^[[:space:]*>-]+//' | awk '{print $1}' | tr -d '",')
        [[ -z "$name" ]] && continue
        [[ "$name" =~ [-._:/0-9] ]] || continue
        valid_model_name "$name" && printf '%s\n' "$name"
    done
}

# Extract `alias = "..."` entries from a Vibe config.toml, both in [[models]]
# tables (alias on its own line) and inline (`models = [{ alias = "x" }]`).
vibe_config_aliases() {
    local file="$1"
    [[ -f "$file" ]] || return 0
    grep -oE '(^|[^A-Za-z0-9_.-])alias[[:space:]]*=[[:space:]]*"[^"]+"' "$file" 2> /dev/null \
        | grep -oE '"[^"]+"$' | tr -d '"'
}

# Parse the GitHub Copilot models catalog (GET api.githubcopilot.com/models):
# keep chat models shown in the interactive `/model` picker
# (model_picker_category: lightweight / versatile / powerful).
copilot_catalog_parse() {
    jq -r '.data[]? | select(.capabilities.type == "chat" and (.model_picker_category != null)) | .id' 2> /dev/null
}

# Fetch the Copilot models catalog using the GitHub OAuth token the user is
# logged in with (the same token exchange the copilot CLI itself performs).
# Tokens are only passed to api.github.com via curl headers, never printed.
copilot_catalog_models() {
    local oauth_file="${GITHUB_COPILOT_HOME:-$HOME/.config/github-copilot}/oauth.json"
    local oauth_token cp_token
    command -v curl &> /dev/null || return 1
    [[ -f "$oauth_file" ]] || return 1
    oauth_token=$(jq -r '."https://github.com/login/oauth"[]?.accessToken // empty' "$oauth_file" 2> /dev/null | head -1)
    [[ -n "$oauth_token" ]] || return 1
    cp_token=$(curl -sf --max-time 10 \
        -H "Authorization: token $oauth_token" -H "Accept: application/json" \
        https://api.github.com/copilot_internal/v2/token 2> /dev/null \
        | jq -r '.token // empty' 2> /dev/null)
    [[ -n "$cp_token" ]] || return 1
    curl -sf --max-time 10 \
        -H "Authorization: Bearer $cp_token" \
        -H "Editor-Version: GitHubCopilot/1.0" \
        -H "Copilot-Integration-Id: vscode-chat" \
        https://api.githubcopilot.com/models 2> /dev/null | copilot_catalog_parse
}

# Model IDs used in past Copilot sessions (the "Recent models" section of `/model`).
copilot_recent_models() {
    local db="${COPILOT_HOME:-$HOME/.copilot}/session-store.db"
    command -v sqlite3 &> /dev/null || return 0
    [[ -f "$db" ]] || return 0
    sqlite3 "$db" \
        "select model from assistant_usage_events where model is not null and model != '' group by model order by max(created_at) desc limit 25;" 2> /dev/null
}

# Legacy fallback: `--model` choices from `copilot --help` (older CLI versions).
copilot_help_models() {
    local cmd="$1"
    run_with_timeout 15 "$cmd" --help < /dev/null 2> /dev/null \
        | tr '\n' ' ' \
        | sed -nE 's/.*--model[^(]*\(choices:([^)]*)\).*/\1/p' \
        | grep -oE '"[^"]+"' | tr -d '"'
}

# Print "source<TAB>model" lines for every model Beehive can discover.
list_available_models() {
    local cli_family="$1" path="$2" cli_cmd="$3"
    local m

    case "$cli_family" in
        claude)
            if [[ -n "${ANTHROPIC_API_KEY:-}" ]] && command -v curl &> /dev/null; then
                curl -sf --max-time 10 \
                    -H @<(printf 'x-api-key: %s\n' "$ANTHROPIC_API_KEY") \
                    -H "anthropic-version: 2023-06-01" \
                    "${ANTHROPIC_BASE_URL:-https://api.anthropic.com}/v1/models?limit=100" 2> /dev/null \
                    | jq -r '.data[]?.id // empty' 2> /dev/null \
                    | while IFS= read -r m; do printf 'api\t%s\n' "$m"; done
            fi
            printf 'alias\t%s\n' opus sonnet haiku
            ;;
        codex)
            sed -nE 's/^[[:space:]]*model[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/p' \
                "${CODEX_HOME:-$HOME/.codex}/config.toml" 2> /dev/null \
                | while IFS= read -r m; do printf 'config\t%s\n' "$m"; done
            ;;
        copilot)
            copilot_catalog_models | while IFS= read -r m; do
                valid_model_name "$m" && printf 'copilot-api\t%s\n' "$m"
            done
            copilot_recent_models | while IFS= read -r m; do
                valid_model_name "$m" && printf 'recent\t%s\n' "$m"
            done
            [[ -n "$cli_cmd" ]] && copilot_help_models "$cli_cmd" \
                | while IFS= read -r m; do printf 'cli\t%s\n' "$m"; done
            ;;
        agy)
            [[ -n "$cli_cmd" ]] && run_with_timeout 20 "$cli_cmd" models < /dev/null 2> /dev/null \
                | filter_model_names \
                | while IFS= read -r m; do printf 'cli\t%s\n' "$m"; done
            ;;
        vibe)
            { vibe_config_aliases "$path/.vibe/config.toml"
              vibe_config_aliases "${VIBE_HOME:-$HOME/.vibe}/config.toml"; } \
                | while IFS= read -r m; do printf 'config\t%s\n' "$m"; done
            ;;
    esac

    # User-provided lists (cursor relies on these): CONF_MODELS/CONF_MODELS_CMD apply to
    # the hive's default CLI, CONF_MODELS_<CLI>/CONF_MODELS_CMD_<CLI> to one CLI.
    local suffix list_var cmd_var list="" models_cmd="" c
    suffix=$(cli_conf_suffix "$cli_family")
    list_var="CONF_MODELS_$suffix"; cmd_var="CONF_MODELS_CMD_$suffix"
    if [[ "$cli_family" == "${DEFAULT_CLI:-$cli_family}" ]]; then
        list="${CONF_MODELS:-}"; models_cmd="${CONF_MODELS_CMD:-}"
    fi
    list="$list ${!list_var:-}"
    printf '%s\n' "$list" | tr ', ' '\n\n' | while IFS= read -r m; do
        [[ -n "$m" ]] && valid_model_name "$m" && printf 'beehive.conf\t%s\n' "$m"
    done
    for c in "$models_cmd" "${!cmd_var:-}"; do
        [[ -n "$c" ]] || continue
        run_config_command "$c" | filter_model_names \
            | while IFS= read -r m; do printf 'models_cmd\t%s\n' "$m"; done
    done
    return 0
}

available_models_json() {
    list_available_models "$@" | jq -R -s -c '
        split("\n") | map(select(length > 0) | split("\t") | {source: .[0], model: .[1]})
        | unique_by(.model)'
}

# Token usage of Claude Code sessions that ran in this project directory,
# aggregated per model for the rolling 5-hour and 7-day windows.
claude_usage_json() {
    local path="$1"
    local slug dir
    slug=$(printf '%s' "$path" | sed 's/[^A-Za-z0-9]/-/g')
    dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/$slug"
    [[ -d "$dir" ]] || return 1

    find "$dir" -name '*.jsonl' -mtime -8 -print0 2> /dev/null \
        | xargs -0 -r cat 2> /dev/null \
        | jq -R -c 'fromjson? | select(.type == "assistant" and .message.usage != null and .timestamp != null)
            | {id: ((.message.id // "") + ":" + (.requestId // "")),
               ts: (.timestamp | sub("\\.[0-9]+"; "") | fromdateiso8601),
               model: (.message.model // "unknown"),
               u: .message.usage}' \
        | jq -s -c --argjson now "$(date +%s)" '
            def agg(since):
                map(select(.ts >= since)) | group_by(.model) | map({
                    model: .[0].model,
                    messages: length,
                    input_tokens: (map(.u.input_tokens // 0) | add),
                    output_tokens: (map(.u.output_tokens // 0) | add),
                    cache_read_tokens: (map(.u.cache_read_input_tokens // 0) | add),
                    cache_creation_tokens: (map(.u.cache_creation_input_tokens // 0) | add)
                });
            unique_by(.id)
            | {source: "claude-code-logs", scope: "this project directory",
               window_5h: agg($now - 18000), window_7d: agg($now - 604800)}'
}

# Latest account-wide rate-limit snapshot recorded by Codex.
codex_usage_json() {
    local dir="${CODEX_HOME:-$HOME/.codex}/sessions"
    [[ -d "$dir" ]] || return 1
    local file snapshot
    while IFS= read -r file; do
        snapshot=$(jq -R -c 'fromjson? | select(.type == "event_msg" and .payload.type == "token_count" and .payload.rate_limits != null)
                | {timestamp, rate_limits: .payload.rate_limits, total_token_usage: .payload.info.total_token_usage}' \
            "$file" 2> /dev/null | tail -1)
        if [[ -n "$snapshot" ]]; then
            jq -c '{source: "codex-session-logs", scope: "account"} + .' <<< "$snapshot"
            return 0
        fi
    done < <(find "$dir" -name 'rollout-*.jsonl' -mtime -8 -print0 2> /dev/null | xargs -0 -r ls -t 2> /dev/null | head -5)
    return 1
}

# Usage command output as JSON (parsed if valid JSON, otherwise a string), or null.
run_usage_cmd() {
    local out
    out=$(run_config_command "$1" | head -c 8000)
    if [[ -z "$out" ]]; then
        echo "null"
    elif jq -e . > /dev/null 2>&1 <<< "$out"; then
        jq -c . <<< "$out"
    else
        jq -R -s -c . <<< "$out"
    fi
}

# Usage for one CLI: built-in log reader plus CONF_USAGE_CMD_<CLI>.
usage_json() {
    local cli_family="$1" path="$2"
    local builtin="null" custom="null" out var
    case "$cli_family" in
        claude) out=$(claude_usage_json "$path") && [[ -n "$out" ]] && builtin="$out" ;;
        codex)  out=$(codex_usage_json) && [[ -n "$out" ]] && builtin="$out" ;;
    esac
    var="CONF_USAGE_CMD_$(cli_conf_suffix "$cli_family")"
    [[ -n "${!var:-}" ]] && custom=$(run_usage_cmd "${!var}")
    jq -n -c --argjson builtin "$builtin" --argjson custom "$custom" '{builtin: $builtin, custom: $custom}'
}

# Session name: explicit --session, the tmux session we run in, config, or folder name.
resolve_hive_session() {
    local path="$1" explicit="$2"
    if [[ -n "$explicit" ]]; then echo "$explicit"; return 0; fi
    if [[ -n "${TMUX:-}" ]] && command -v tmux &> /dev/null; then
        local current
        current=$(tmux display-message -p '#S' 2> /dev/null || true)
        if [[ -n "$current" && -n "$(tmux show-options -t "$current" -v -q @beehive_cli 2> /dev/null)" ]]; then
            echo "$current"; return 0
        fi
    fi
    resolve_setting "" "" "${CONF_SESSION:-}" "$(basename "$path")"
}

hive_option() {
    tmux show-options -t "$1" -v -q "$2" 2> /dev/null || true
}

# Agents of a running hive: pane, actor, CLI, model, CLI command.
# Panes from older launches without per-pane CLI metadata fall back to the hive default.
hive_agents_json() {
    local session="$1" default_cli="${2:-}" default_cmd="${3:-}"
    command -v tmux &> /dev/null && tmux has-session -t "$session" 2> /dev/null || { echo "[]"; return 0; }
    # tmux sanitizes tabs in format output, so use "|" (never valid in actor, CLI, or model names)
    tmux list-panes -s -t "$session" -F '#{pane_id}|#{@beehive_actor}|#{@beehive_cli}|#{@beehive_model}|#{@beehive_cli_cmd}' 2> /dev/null \
        | jq -R -s -c --arg dcli "$default_cli" --arg dcmd "$default_cmd" '
            split("\n") | map(select(length > 0) | split("|")
            | select((.[1] // "") != "")
            | {pane: .[0], actor: .[1],
               cli: (if (.[2] // "") == "" then $dcli else .[2] end),
               model: (.[3] // ""),
               command: ((.[4:] | join("|")) as $c | if $c == "" then $dcmd else $c end)})'
}

#######################################
# beehive --models: agents, models and usage per CLI
#######################################
do_models() {
    local path="$1" session_arg="$2" cli_arg="$3"
    path=$(cd "$path" && pwd -P)
    load_config "$path" > /dev/null || true

    local session
    session=$(resolve_hive_session "$path" "$session_arg")
    DEFAULT_CLI=$(hive_option "$session" @beehive_cli)
    [[ -z "$DEFAULT_CLI" ]] && DEFAULT_CLI=$(resolve_setting "$cli_arg" "" "${CONF_CLI:-}" "claude")
    CLI_CMD_OVERRIDE=$(hive_option "$session" @beehive_cli_cmd)
    [[ -z "$CLI_CMD_OVERRIDE" ]] && CLI_CMD_OVERRIDE="${CONF_CLI_CMD:-}"
    [[ -z "${ANTHROPIC_API_KEY:-}" ]] && ANTHROPIC_API_KEY="${CONF_ANTHROPIC_API_KEY:-}"
    [[ -z "${ANTHROPIC_BASE_URL:-}" ]] && ANTHROPIC_BASE_URL="${CONF_ANTHROPIC_BASE_URL:-}"

    local agents in_use
    agents=$(hive_agents_json "$session" "$DEFAULT_CLI" "$CLI_CMD_OVERRIDE")
    in_use=$(jq -r '[.[].cli] | unique | join(" ")' <<< "$agents")
    [[ -z "$in_use" ]] && in_use="$DEFAULT_CLI"

    # Report every CLI in use plus every other installed CLI, so the Queen can
    # move Bees to another CLI (and its subscription) when one runs low.
    local clis="[]" fam cmd used available usage
    for fam in $SUPPORTED_CLIS; do
        used=false
        [[ " $in_use " == *" $fam "* ]] && used=true
        cmd=$(jq -r --arg f "$fam" 'map(select(.cli == $f and .command != "")) | .[0].command // empty' <<< "$agents")
        [[ -z "$cmd" ]] && cmd=$(resolve_agent_cmd "$fam" || true)
        [[ "$used" == false && -z "$cmd" ]] && continue
        available=$(available_models_json "$fam" "$path" "$cmd")
        usage=$(usage_json "$fam" "$path")
        clis=$(jq -c --arg cli "$fam" --arg cmd "$cmd" --argjson used "$used" \
            --argjson available "$available" --argjson usage "$usage" \
            '. + [{cli: $cli, command: $cmd, installed: ($cmd != ""), in_use: $used, available: $available, usage: $usage}]' <<< "$clis")
    done

    local hive_usage="null"
    [[ -n "${CONF_USAGE_CMD:-}" ]] && hive_usage=$(run_usage_cmd "$CONF_USAGE_CMD")

    local report
    report=$(jq -n -c --arg cli "$DEFAULT_CLI" --arg session "$session" --arg path "$path" \
        --argjson agents "$agents" --argjson clis "$clis" --argjson hive_usage "$hive_usage" \
        '{default_cli: $cli, session: $session, path: $path, agents: $agents, clis: $clis, hive_usage: $hive_usage}')

    if $JSON_OUTPUT; then
        jq . <<< "$report"
        return 0
    fi

    echo ""
    info "Hive models (session: $session, default CLI: $DEFAULT_CLI)"
    echo ""
    echo "Agents:"
    jq -r 'if (.agents | length) == 0 then "  (no running hive session found)"
           else .agents[] | "  \(.actor)\t\(.cli)\t\(if .model == "" then "(CLI default)" else .model end)" end' <<< "$report"
    jq -r '
        def tokens: "\(.model): \(.messages) msgs, in \(.input_tokens), out \(.output_tokens), cache read \(.cache_read_tokens)";
        .clis[] |
        "",
        "\(.cli)\(if .in_use then " (in use)" else "" end)\(if .installed then "" else " — not installed" end)",
        "  Models: \(if (.available | length) == 0 then "(none discovered; set CONF_MODELS_\(.cli | ascii_upcase))" else ([.available[].model] | join(", ")) end)",
        (if .usage.builtin.window_5h then
            "  Usage last 5h (\(.usage.builtin.scope)):",
            (.usage.builtin.window_5h[] | "    " + tokens),
            "  Usage last 7d:",
            (.usage.builtin.window_7d[] | "    " + tokens)
         elif .usage.builtin.rate_limits then
            (.usage.builtin.rate_limits | to_entries[] | select(.value | type == "object")
              | "  Rate limit \(.key): \(.value.used_percent // "?")% used (window \(.value.window_minutes // "?") min)")
         else empty end),
        (if .usage.custom != null then "  Usage: \(.usage.custom | if type == "string" then rtrimstr("\n") else tojson end)" else empty end),
        (if .usage.builtin == null and .usage.custom == null then "  Usage: (no data; set CONF_USAGE_CMD_\(.cli | ascii_upcase))" else empty end)
    ' <<< "$report"
    jq -r 'if .hive_usage != null then "", "Hive usage: \(.hive_usage | if type == "string" then rtrimstr("\n") else tojson end)" else empty end' <<< "$report"
    echo ""
}

#######################################
# beehive --switch-model bee-N MODEL [--cli NAME]: restart one Bee with another model/CLI
#######################################
do_switch_model() {
    local path="$1" session_arg="$2" actor="$3" model="$4" new_cli="${5:-}"
    path=$(cd "$path" && pwd -P)
    load_config "$path" > /dev/null || true

    [[ "$actor" =~ ^bee-([0-9]+)$ ]] || die "--switch-model only restarts Bees (bee-N); got: $actor"
    local bee_num="${BASH_REMATCH[1]}"
    [[ "$model" == "default" ]] && model=""
    if [[ -n "$model" ]]; then
        valid_model_name "$model" || die "Invalid model name: $model"
    fi
    if [[ -n "$new_cli" ]]; then
        is_supported_cli "$new_cli" || die "--cli must be one of: $SUPPORTED_CLIS (got: $new_cli)"
    fi

    command -v tmux &> /dev/null || die "tmux required"
    local session
    session=$(resolve_hive_session "$path" "$session_arg")
    tmux has-session -t "$session" 2> /dev/null || die "No running hive session '$session'"

    DEFAULT_CLI=$(hive_option "$session" @beehive_cli)
    [[ -n "$DEFAULT_CLI" ]] || die "Session '$session' has no Beehive metadata. Relaunch it with this beehive version."
    CLI_CMD_OVERRIDE=$(hive_option "$session" @beehive_cli_cmd)
    APPROVAL_MODE=$(hive_option "$session" @beehive_approval)
    AWS_PROFILE=$(hive_option "$session" @beehive_aws_profile)
    AWS_REGION=$(hive_option "$session" @beehive_aws_region)
    ANTHROPIC_BASE_URL=$(hive_option "$session" @beehive_base_url)
    ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-${CONF_ANTHROPIC_API_KEY:-}}"
    local hive_path
    hive_path=$(hive_option "$session" @beehive_path)
    [[ -n "$hive_path" ]] && path="$hive_path"

    local agent pane current_cli current_cmd
    agent=$(hive_agents_json "$session" "$DEFAULT_CLI" "$CLI_CMD_OVERRIDE" | jq -c --arg a "$actor" 'map(select(.actor == $a)) | .[0] // empty')
    [[ -n "$agent" ]] || die "No pane for $actor in session '$session'"
    pane=$(jq -r '.pane' <<< "$agent")
    current_cli=$(jq -r '.cli' <<< "$agent")
    current_cmd=$(jq -r '.command' <<< "$agent")

    CLI_FAMILY="${new_cli:-$current_cli}"
    if [[ "$CLI_FAMILY" == "$current_cli" && -n "$current_cmd" ]]; then
        AGENT_CMD="$current_cmd"
    else
        AGENT_CMD=$(resolve_agent_cmd "$CLI_FAMILY") || die "Agent CLI '$CLI_FAMILY' not found. Install it or set CONF_CLI_CMD_$(cli_conf_suffix "$CLI_FAMILY")."
    fi

    if [[ -n "$model" ]]; then
        local known
        known=$(available_models_json "$CLI_FAMILY" "$path" "$AGENT_CMD")
        if [[ "$(jq 'length' <<< "$known")" -gt 0 ]] && ! jq -e --arg m "$model" 'any(.[]; .model == $m)' <<< "$known" > /dev/null; then
            warn "Model '$model' was not in the discovered model list for $CLI_FAMILY; launching anyway"
        fi
    fi

    local prompt pane_cmd
    prompt="$(bee_prompt_text "$bee_num" "$path") Queen restarted you on $CLI_FAMILY with model '${model:-CLI default}'; resume from the latest checkpoint comment on your assigned bead."
    pane_cmd=$(build_pane_command "$prompt" "$model" "$actor")

    tmux respawn-pane -k -t "$pane" -c "$path"
    tmux set-option -p -t "$pane" @beehive_cli "$CLI_FAMILY"
    tmux set-option -p -t "$pane" @beehive_cli_cmd "$AGENT_CMD"
    tmux set-option -p -t "$pane" @beehive_model "$model"
    tmux select-pane -t "$pane" -T "🐝 Bee $bee_num"
    sleep 1
    tmux send-keys -t "$pane" "$pane_cmd" Enter

    success "✓ Restarted $actor on $CLI_FAMILY with model ${model:-(CLI default)}"
}

#######################################
# Status display (beads-backed)
#######################################
do_status() {
    local path="$1"

    [[ ! -d "$path/plans" ]] && die "Not initialized. Run: beehive --init $path"
    [[ ! -d "$path/.beads" ]] && die "Beads not initialized. Run: beehive --init $path"

    if $JSON_OUTPUT; then
        _do_status_json "$path"
    else
        _do_status_human "$path"
    fi
}

_do_status_json() {
    local path="$1"

    # Get all issues from beads
    local all_issues
    all_issues=$(cd "$path" && bd list --json --all 2>/dev/null || echo "[]")

    local ready_issues
    ready_issues=$(cd "$path" && bd ready --json 2>/dev/null || echo "[]")

    # Build agents list from assignee field
    local agents
    agents=$(echo "$all_issues" | jq '[.[] | select(.assignee != null and .assignee != "") | {agent: .assignee, status: .status, item_id: .id, title: .title}] | group_by(.agent) | map({agent: .[0].agent, items: .})')

    # Output combined JSON
    jq -cn \
        --arg project "$(basename "$path")" \
        --argjson issues "$all_issues" \
        --argjson ready "$ready_issues" \
        --argjson agents "$agents" \
        '{project:$project, issues:$issues, ready:$ready, agents:$agents}'
}

_do_status_human() {
    local path="$1"

    echo ""
    echo -e "${GREEN}Beehive Status${NC} — $(basename "$path")"

    # All open issues
    echo ""
    echo -e "${CYAN}  Work Items${NC}"
    local issues
    issues=$(cd "$path" && bd list --json 2>/dev/null || echo "[]")
    local count
    count=$(echo "$issues" | jq 'length')

    if [[ "$count" -eq 0 ]]; then
        echo "  (none)"
    else
        echo "$issues" | jq -r '.[] | "  \(if .status == "open" then "○" elif .status == "in_progress" then "●" elif .status == "blocked" then "✕" else "·" end) \(.id) \(.status) P\(.priority) \(.title)\(if .assignee != null and .assignee != "" then " [\(.assignee)]" else "" end)"'
    fi

    # Agent assignments
    echo ""
    echo -e "${CYAN}  Agents${NC}"
    local assigned
    assigned=$(echo "$issues" | jq -r '.[] | select(.assignee != null and .assignee != "") | "\(.assignee)\t\(.status)\t\(.id)\t\(.title)"' 2>/dev/null)
    if [[ -z "$assigned" ]]; then
        echo "  (no active assignments)"
    else
        echo "$assigned" | while IFS=$'\t' read -r agent status item_id title; do
            printf "  %-10s %s %s %s\n" "$agent" "$status" "$item_id" "$title"
        done
    fi

    # Ready work (unblocked, unassigned)
    echo ""
    echo -e "${CYAN}  Ready${NC}"
    local ready
    ready=$(cd "$path" && bd ready --json 2>/dev/null || echo "[]")
    local ready_count
    ready_count=$(echo "$ready" | jq 'length')
    if [[ "$ready_count" -eq 0 ]]; then
        echo "  (none — all work assigned or blocked)"
    else
        echo "$ready" | jq -r '.[] | "  ◎ \(.id) P\(.priority) \(.title)"'
    fi

    echo ""
}

#######################################
# Validate project health
#######################################
do_validate() {
    local path="$1"
    local errors=0

    [[ ! -d "$path/plans" ]] && die "Not initialized. Run: beehive --init $path"
    [[ ! -d "$path/.beads" ]] && die "Beads not initialized. Run: beehive --init $path"

    echo ""
    echo -e "${GREEN}Beehive Validate${NC} — $(basename "$path")"
    echo ""

    # Check bd health
    local doctor_output doctor_status=0
    if ! doctor_output=$(cd "$path" && bd list --json --all >/dev/null 2>&1 && bd doctor 2>&1); then
        doctor_status=$?
    fi
    if [[ $doctor_status -eq 0 ]]; then
        echo -e "  ${GREEN}✓${NC} bd doctor: healthy"
    else
        echo -e "  ${RED}✕${NC} bd doctor: issues found"
        echo "$doctor_output" | sed 's/^/    /'
        errors=$((errors + 1))
    fi

    # Validate sessions.jsonl if present
    local meta="$path/plans/_meta"
    if [[ -s "$meta/sessions.jsonl" ]]; then
        local line_num=0
        local sess_errors=0
        while IFS= read -r line; do
            line_num=$((line_num + 1))
            [[ -z "$line" ]] && continue
            if ! echo "$line" | jq empty 2>/dev/null; then
                echo -e "  ${RED}✕${NC} sessions.jsonl:$line_num — invalid JSON"
                sess_errors=$((sess_errors + 1))
            fi
        done < "$meta/sessions.jsonl"
        if [[ "$sess_errors" -eq 0 ]]; then
            echo -e "  ${GREEN}✓${NC} sessions.jsonl: $line_num lines OK"
        else
            errors=$((errors + sess_errors))
        fi
    else
        echo -e "  ${GREEN}✓${NC} sessions.jsonl: empty (OK)"
    fi

    # Check issue counts
    local issue_counts total_count open_count in_progress_count blocked_count closed_count other_count
    issue_counts=$(cd "$path" && bd list --json --all 2>/dev/null | jq -r '
        reduce .[] as $issue (
            {total: 0, open: 0, in_progress: 0, blocked: 0, closed: 0, other: 0};
            .total += 1 |
            if $issue.status == "open" then .open += 1
            elif $issue.status == "in_progress" then .in_progress += 1
            elif $issue.status == "blocked" then .blocked += 1
            elif $issue.status == "closed" then .closed += 1
            else .other += 1
            end
        ) | "\(.total) \(.open) \(.in_progress) \(.blocked) \(.closed) \(.other)"')
    read -r total_count open_count in_progress_count blocked_count closed_count other_count <<< "$issue_counts"
    echo -e "  ${GREEN}✓${NC} issues: $total_count total ($open_count open, $in_progress_count in_progress, $blocked_count blocked, $closed_count closed, $other_count other)"

    echo ""
    if [[ $errors -eq 0 ]]; then
        success "✓ Validation passed (0 errors)"
        return 0
    else
        echo -e "${RED}✕ Validation failed ($errors errors)${NC}"
        return 1
    fi
}

#######################################
# Stop legacy persistent beads server
#######################################
do_stop() {
    local path="$1"
    [[ ! -d "$path/.beads" ]] && die "No beads database found in $path"

    info "Beehive no longer starts a persistent Beads server for Beads 1.0+ embedded mode."
    info "If a legacy Dolt server is running, stop it manually from the workspace with: bd dolt stop"
}

usage() {
    cat << EOF
Usage: beehive [options] [path]

Orchestrate multiple CLI-backed coding agents in tmux.

Commands:
    beehive [path]              Launch agents (default: current directory)
    beehive --init [path]       Initialize repo/workspace structure
    beehive --upgrade [path]    Upgrade skills, commands, and template (preserves data)
    beehive --status [path]     Show work items, agent states, and ready queue
    beehive --validate [path]   Validate beads health and sessions.jsonl
    beehive --stop [path]       Stop the persistent beads server
    beehive --models [path]     Show per-agent models, available models, and usage
    beehive --switch-model bee-N MODEL [--cli NAME]
                                Restart one Bee with another model and optionally another CLI
                                ('default' = CLI default model)

Options:
    --session NAME       Session name (default: folder name)
    --model MODEL        Anthropic model override (all agents)
    --bee-model MODEL    Model override for all Bees
    --queen-model MODEL  Model override for Queen
    --cli NAME           Agent CLI family: claude, codex, cursor, copilot, agy, vibe (default: claude)
    --bee-cli NAME       CLI for all Bees (default: --cli); per Bee via CONF_CLI_BEE_N
    --queen-cli NAME     CLI for the Queen (default: --cli)
    --cli-cmd CMD        Explicit command/path for selected CLI
    --approval-mode MODE Approval handling: auto or manual (default: auto)
    --bees N             Number of Bees (2-5, default: 3)
    --no-queen           Launch only Bees; use when Queen runs separately
    --queen-only         Launch one Queen directly without tmux
    --profile PROF       AWS profile for Bedrock
    --region REGION      AWS region for Bedrock
    --base-url URL       Anthropic API base URL (for API proxies)
    --api-key KEY        Anthropic API key
    --dry-run            Preview upgrade changes without modifying files
    --json               Machine-readable JSON output for --status and --models
    --yes                Skip confirmation
    --version            Show version
    --help               Show this help

Examples:
    beehive                      # Run in current directory
    beehive ~/myproject          # Run in specific path
    beehive --init ~/projects    # Initialize (auto-detects workspace vs repo)
    beehive --upgrade            # Upgrade skills/commands/template to latest
    beehive --upgrade --dry-run  # Preview what upgrade would change
    beehive --status --json      # Machine-readable status for CI/scripts
    beehive --validate           # Check beads health and sessions metadata
    beehive --base-url http://localhost:8090 --api-key sk-ant-xxx --yes
    beehive --queen-model claude-opus-4-6 --bee-model claude-sonnet-4-6
    beehive --cli codex              # Launch with Codex CLI
    beehive --cli codex --approval-mode manual
    beehive --cli cursor             # Launch with Cursor CLI (agent command)
    beehive --cli copilot            # Launch with GitHub Copilot CLI
    beehive --cli agy                # Launch with Antigravity CLI
    beehive --cli vibe               # Launch with Mistral Vibe CLI
    beehive --bee-cli codex --queen-cli claude   # Bees on Codex, Queen on Claude Code
    beehive --queen-only             # Launch one Queen directly, no tmux
    beehive --bees 2                 # Launch 2 bees + Queen (3 agents total)
    beehive --bees 5                 # Launch 5 bees + Queen (6 agents total)
    beehive --bees 2 --no-queen      # Launch 2 bees only; Queen runs elsewhere

EOF
    exit 0
}

#######################################
# Main
#######################################
main() {
    local cmd=""
    local path=""
    local skip_confirm=false
    DRY_RUN=false
    JSON_OUTPUT=false

    # CLI overrides (resolved later via resolve_setting)
    local CLI_SESSION_NAME="" CLI_MODEL=""
    local CLI_MODEL_BEE="" CLI_MODEL_QUEEN=""
    local CLI_AWS_PROFILE="" CLI_AWS_REGION=""
    local CLI_ANTHROPIC_BASE_URL="" CLI_ANTHROPIC_API_KEY=""
    local CLI_BEES="" CLI_QUEEN="" CLI_QUEEN_ONLY="" CLI_CLI="" CLI_CMD_OVERRIDE="" CLI_APPROVAL_MODE=""
    local SWITCH_ACTOR="" SWITCH_MODEL="" CLI_BEE_CLI="" CLI_QUEEN_CLI=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --init)         cmd="init"; shift ;;
            --upgrade)      cmd="upgrade"; shift ;;
            --status)       cmd="status"; shift ;;
            --validate)     cmd="validate"; shift ;;
            --stop)         cmd="stop"; shift ;;
            --models)       cmd="models"; shift ;;
            --switch-model)
                [[ -z "${2:-}" || "${2:-}" == -* || -z "${3:-}" || "${3:-}" == -* ]] && die "--switch-model requires an agent (bee-N) and a model (or 'default')"
                cmd="switch-model"; SWITCH_ACTOR="$2"; SWITCH_MODEL="$3"; shift 3 ;;
            --dry-run)      DRY_RUN=true; shift ;;
            --json)         JSON_OUTPUT=true; shift ;;
            --session)      [[ -z "${2:-}" || "${2:-}" == -* ]] && die "--session requires a value"; CLI_SESSION_NAME="$2"; shift 2 ;;
            --model)        [[ -z "${2:-}" || "${2:-}" == -* ]] && die "--model requires a value"; CLI_MODEL="$2"; shift 2 ;;
            --bee-model)    [[ -z "${2:-}" || "${2:-}" == -* ]] && die "--bee-model requires a value"; CLI_MODEL_BEE="$2"; shift 2 ;;
            --queen-model)  [[ -z "${2:-}" || "${2:-}" == -* ]] && die "--queen-model requires a value"; CLI_MODEL_QUEEN="$2"; shift 2 ;;
            --profile)      [[ -z "${2:-}" || "${2:-}" == -* ]] && die "--profile requires a value"; CLI_AWS_PROFILE="$2"; shift 2 ;;
            --region)       [[ -z "${2:-}" || "${2:-}" == -* ]] && die "--region requires a value"; CLI_AWS_REGION="$2"; shift 2 ;;
            --base-url)     [[ -z "${2:-}" ]] && die "--base-url requires a value"; CLI_ANTHROPIC_BASE_URL="$2"; shift 2 ;;
            --api-key)      [[ -z "${2:-}" ]] && die "--api-key requires a value"; CLI_ANTHROPIC_API_KEY="$2"; shift 2 ;;
            --cli)          [[ -z "${2:-}" || "${2:-}" == -* ]] && die "--cli requires one of: claude, codex, cursor, copilot, agy, vibe"; CLI_CLI="$2"; shift 2 ;;
            --bee-cli)      [[ -z "${2:-}" || "${2:-}" == -* ]] && die "--bee-cli requires a CLI name"; CLI_BEE_CLI="$2"; shift 2 ;;
            --queen-cli)    [[ -z "${2:-}" || "${2:-}" == -* ]] && die "--queen-cli requires a CLI name"; CLI_QUEEN_CLI="$2"; shift 2 ;;
            --cli-cmd)      [[ -z "${2:-}" || "${2:-}" == -* ]] && die "--cli-cmd requires a command path/name"; CLI_CMD_OVERRIDE="$2"; shift 2 ;;
            --approval-mode) [[ -z "${2:-}" || "${2:-}" == -* ]] && die "--approval-mode requires auto or manual"; CLI_APPROVAL_MODE="$2"; shift 2 ;;
            --bees)         [[ -z "${2:-}" || "${2:-}" == -* ]] && die "--bees requires a number (2-5)"; CLI_BEES="$2"; shift 2 ;;
            --no-queen)     CLI_QUEEN="false"; shift ;;
            --queen-only)   CLI_QUEEN_ONLY="true"; shift ;;
            --yes|-y)       skip_confirm=true; shift ;;
            --version)      echo "beehive v$VERSION"; exit 0 ;;
            --help|-h)      usage ;;
            -*)             die "Unknown option: $1" ;;
            *)              path="$1"; shift ;;
        esac
    done

    # Require jq for all commands (--help/--version exit above before reaching here)
    require_jq
    require_bd

    path="${path:-$(pwd)}"
    [[ ! -d "$path" ]] && die "Directory not found: $path"

    case "$cmd" in
        init) do_init "$path" ;;
        upgrade) do_upgrade "$path" ;;
        status) do_status "$path" ;;
        validate) do_validate "$path" ;;
        stop) do_stop "$path" ;;
        models) do_models "$path" "$CLI_SESSION_NAME" "$CLI_CLI" ;;
        switch-model) do_switch_model "$path" "$CLI_SESSION_NAME" "$SWITCH_ACTOR" "$SWITCH_MODEL" "$CLI_CLI" ;;
        *)
            echo ""
            echo -e "${GREEN}Beehive${NC} v$VERSION"
            echo ""

            local mode
            mode=$(detect_mode "$path")

            # Load config early to show settings
            load_config "$path" || true

            # Resolve all settings: CLI → config (with role-specific precedence)
            # These are set as globals for do_launch() and build_pane_command()
            SESSION_NAME=$(resolve_setting "$CLI_SESSION_NAME" "" "$CONF_SESSION" "$(basename "$path")")
            AWS_PROFILE=$(resolve_setting "$CLI_AWS_PROFILE" "" "$CONF_AWS_PROFILE" "")
            AWS_REGION=$(resolve_setting "$CLI_AWS_REGION" "" "$CONF_AWS_REGION" "")
            ANTHROPIC_BASE_URL=$(resolve_setting "$CLI_ANTHROPIC_BASE_URL" "" "$CONF_ANTHROPIC_BASE_URL" "")
            ANTHROPIC_API_KEY=$(resolve_setting "$CLI_ANTHROPIC_API_KEY" "" "$CONF_ANTHROPIC_API_KEY" "")

            local bee_model queen_model
            bee_model=$(resolve_setting "$CLI_MODEL_BEE" "$CLI_MODEL" "$CONF_MODEL_BEE" "$CONF_MODEL")
            queen_model=$(resolve_setting "$CLI_MODEL_QUEEN" "$CLI_MODEL" "$CONF_MODEL_QUEEN" "$CONF_MODEL")

            local cli_family
            cli_family=$(resolve_setting "$CLI_CLI" "" "$CONF_CLI" "claude")
            is_supported_cli "$cli_family" || die "--cli/CONF_CLI must be one of: $SUPPORTED_CLIS (got: $cli_family)"
            DEFAULT_CLI="$cli_family"

            # Per-agent CLIs: --bee-cli/CONF_CLI_BEE for all Bees, CONF_CLI_BEE_N for one Bee,
            # --queen-cli/CONF_CLI_QUEEN for the Queen. Model settings shared by several agents
            # (--model, CONF_MODEL) only apply to agents on the default CLI.
            local bee_role_cli
            bee_role_cli=$(resolve_setting "$CLI_BEE_CLI" "" "${CONF_CLI_BEE:-}" "$cli_family")
            QUEEN_CLI=$(resolve_setting "$CLI_QUEEN_CLI" "" "${CONF_CLI_QUEEN:-}" "$cli_family")
            is_supported_cli "$bee_role_cli" || die "--bee-cli/CONF_CLI_BEE must be one of: $SUPPORTED_CLIS (got: $bee_role_cli)"
            is_supported_cli "$QUEEN_CLI" || die "--queen-cli/CONF_CLI_QUEEN must be one of: $SUPPORTED_CLIS (got: $QUEEN_CLI)"
            [[ "$bee_role_cli" != "$cli_family" ]] && bee_model=$(resolve_setting "$CLI_MODEL_BEE" "" "$CONF_MODEL_BEE" "")
            [[ "$QUEEN_CLI" != "$cli_family" ]] && queen_model=$(resolve_setting "$CLI_MODEL_QUEEN" "" "$CONF_MODEL_QUEEN" "")
            CLI_CMD_OVERRIDE=$(resolve_setting "$CLI_CMD_OVERRIDE" "" "$CONF_CLI_CMD" "")

            local approval_mode
            approval_mode=$(resolve_setting "$CLI_APPROVAL_MODE" "" "$CONF_APPROVAL_MODE" "auto")
            [[ "$approval_mode" == "auto" || "$approval_mode" == "manual" ]] || die "--approval-mode/CONF_APPROVAL_MODE must be auto or manual (got: $approval_mode)"
            CLI_FAMILY="$cli_family"
            APPROVAL_MODE="$approval_mode"

            local num_bees launch_queen queen_only
            num_bees=$(resolve_setting "$CLI_BEES" "" "$CONF_BEES" "3")
            launch_queen=$(resolve_setting "$CLI_QUEEN" "" "$CONF_QUEEN" "true")
            queen_only=$(resolve_setting "$CLI_QUEEN_ONLY" "" "" "false")
            [[ "$queen_only" == "true" || "$queen_only" == "false" ]] || die "--queen-only must resolve to true or false (got: $queen_only)"
            [[ "$launch_queen" == "true" || "$launch_queen" == "false" ]] || die "--no-queen/CONF_QUEEN must resolve to true or false (got: $launch_queen)"
            [[ "$queen_only" == "true" && "$launch_queen" == "false" ]] && die "--queen-only cannot be combined with --no-queen"
            if [[ "$queen_only" != "true" ]]; then
                [[ "$num_bees" =~ ^[2-5]$ ]] || die "--bees must be 2, 3, 4, or 5 (got: $num_bees)"
            fi
            local queen_panes=0
            [[ "$launch_queen" == "true" ]] && queen_panes=1
            local total_agents=$((num_bees + queen_panes))

            BEE_CLIS=(); BEE_MODELS=()
            local n cli_var model_var used_clis=""
            if [[ "$queen_only" != "true" ]]; then
                for (( n=1; n<=num_bees; n++ )); do
                    cli_var="CONF_CLI_BEE_$n"; model_var="CONF_MODEL_BEE_$n"
                    BEE_CLIS[n]="${!cli_var:-$bee_role_cli}"
                    is_supported_cli "${BEE_CLIS[$n]}" || die "$cli_var must be one of: $SUPPORTED_CLIS (got: ${BEE_CLIS[$n]})"
                    if [[ -n "${!model_var:-}" ]]; then
                        BEE_MODELS[n]="${!model_var}"
                    elif [[ "${BEE_CLIS[$n]}" == "$bee_role_cli" ]]; then
                        BEE_MODELS[n]="$bee_model"
                    else
                        BEE_MODELS[n]=""
                    fi
                    used_clis+=" ${BEE_CLIS[$n]}"
                done
            fi
            [[ "$launch_queen" == "true" ]] && used_clis+=" $QUEEN_CLI"
            local mixed_clis=false
            [[ "$(printf '%s\n' $used_clis | sort -u | wc -l | tr -d ' ')" -gt 1 ]] && mixed_clis=true

            if [[ "$mode" == "workspace" ]]; then
                info "Mode: Workspace"
            else
                info "Mode: Single repo"
            fi
            info "Path: $path"
            if $mixed_clis; then
                local agent_line="CLIs:"
                for (( n=1; n<=num_bees; n++ )); do
                    agent_line+=" bee-$n=${BEE_CLIS[$n]}${BEE_MODELS[$n]:+(${BEE_MODELS[$n]})}"
                done
                [[ "$launch_queen" == "true" ]] && agent_line+=" queen=$QUEEN_CLI${queen_model:+($queen_model)}"
                info "$agent_line"
            else
                local single_cli
                read -r single_cli _ <<< "$used_clis"
                info "CLI: ${single_cli:-$cli_family}"
            fi
            info "Approval mode: $approval_mode"
            [[ " $used_clis " == *" cursor "* && "$approval_mode" == "auto" ]] && warn "Cursor has no verified Beehive auto-approval profile; native Cursor permissions remain in effect"
            [[ -n "$CLI_CMD_OVERRIDE" ]] && info "CLI command: $CLI_CMD_OVERRIDE"
            if [[ "$queen_only" == "true" ]]; then
                info "Agents: Queen only (no tmux)"
            elif [[ "$launch_queen" == "true" ]]; then
                [[ "$num_bees" -ne 3 ]] && info "Agents: $num_bees bees + Queen ($total_agents total)"
            else
                info "Agents: $num_bees bees, no Queen ($total_agents total)"
            fi
            if $mixed_clis; then
                :  # models are shown per agent above
            elif [[ "$bee_model" != "$queen_model" ]] && [[ -n "$bee_model" || -n "$queen_model" ]]; then
                [[ -n "$bee_model" ]] && info "Bee model: $bee_model"
                [[ -n "$queen_model" ]] && info "Queen model: $queen_model"
            elif [[ -n "$bee_model" ]]; then
                info "Model: $bee_model"
            fi
            if [[ -n "$ANTHROPIC_BASE_URL" ]]; then
                info "Backend: API proxy ($ANTHROPIC_BASE_URL)"
            elif [[ -n "$AWS_PROFILE" ]]; then
                info "Backend: Bedrock (profile: $AWS_PROFILE, region: ${AWS_REGION:-us-east-1})"
            fi
            echo ""

            if ! $skip_confirm; then
                if [[ "$queen_only" == "true" ]]; then
                    read -p "Launch Queen only without tmux? [Y/n] " -n 1 -r
                elif [[ "$launch_queen" == "true" ]]; then
                    read -p "Launch $total_agents agents ($num_bees bees + Queen)? [Y/n] " -n 1 -r
                else
                    read -p "Launch $total_agents agents ($num_bees bees, no Queen)? [Y/n] " -n 1 -r
                fi
                echo ""
                [[ $REPLY =~ ^[Nn]$ ]] && { echo "Aborted."; exit 0; }
            fi

            if [[ "$queen_only" == "true" ]]; then
                do_queen_only "$path" "$queen_model" "$cli_family"
            else
                do_launch "$path" "$bee_model" "$queen_model" "$num_bees" "$launch_queen" "$cli_family"
            fi
            ;;
    esac
}

if [[ "${BEEHIVE_SOURCE_ONLY:-false}" != "true" ]]; then
    main "$@"
fi
